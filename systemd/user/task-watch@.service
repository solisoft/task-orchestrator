[Unit]
Description=Task orchestrator watcher for %i
Documentation=file://%h/workspace/soli/task-orchestrator/README.md
# %i is the systemd-escaped absolute path of the project being watched.
# Enable per-repo with:
#   ./bin/install-watcher /path/to/repo
After=default.target

[Service]
Type=simple
# systemd-user services don't load ~/.bashrc, so we have to spell out
# the PATH that task-run / claude / gh / inotifywait need. ~/.local/bin
# is where Claude Code installs the `claude` CLI by default.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workspace/soli/task-orchestrator/bin/task-watch %I
Restart=on-failure
RestartSec=5
# Log to a file the user always has read access to. journalctl --user
# is unreliable on distros that don't keep persistent user logs, and
# adm/systemd-journal group membership shouldn't be a prerequisite.
StandardOutput=append:%h/.local/state/task-orchestrator/watcher.log
StandardError=append:%h/.local/state/task-orchestrator/watcher.log

[Install]
WantedBy=default.target
