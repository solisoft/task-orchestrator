<div class="min-h-screen text-white">
  <div class="max-w-md mx-auto px-6 py-24">
    <div class="rounded-xl glass-card p-8 animate-fade-in">
      <h1 class="text-2xl font-bold gradient-text mb-6 text-center">Sign in</h1>

      <% if error != nil %>
        <div class="rounded-lg border border-red-500/40 bg-red-500/10 text-red-200 text-sm px-4 py-3 mb-4">
          <%= error %>
        </div>
      <% end %>

      <form method="post" action="/login" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Email</label>
          <input type="email" name="email" required value="<%= email ?? "" %>"
                 class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-4 py-2 text-sm text-slate-100"
                 placeholder="you@example.com" autofocus>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Password</label>
          <input type="password" name="password" required
                 class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-4 py-2 text-sm text-slate-100"
                 placeholder="Your password">
        </div>
        <button type="submit" class="w-full rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-3 transition-colors">
          Sign in
        </button>
      </form>

      <p class="text-xs text-slate-500 mt-6 text-center">
        Task Orchestrator
      </p>
    </div>
  </div>
</div>
