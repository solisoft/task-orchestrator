<div class="min-h-screen text-white">
    <div class="max-w-6xl mx-auto px-6 py-12">
        <!-- Hero section -->
        <header class="mb-14 animate-fade-in">
            <div class="flex items-baseline justify-between flex-wrap gap-3 mb-6">
                <div>
                    <h1 class="text-4xl font-bold tracking-tight hero-shimmer">Task Orchestrator</h1>
                    <p class="mt-2 text-slate-400 font-mono text-sm"><%= root %></p>
                </div>
                <a href="/docs" class="rounded-lg glass-card-light hover:bg-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">Docs</a>
            </div>
            <p class="text-slate-400 text-sm max-w-2xl leading-relaxed">
                Drop a markdown task spec, queue it, and watch a Claude Code agent dispatch it end-to-end inside a fresh git worktree.
            </p>
        </header>

        <!-- Agent usage tile -->
        <section class="mb-10 rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-1">
            <div class="flex items-baseline justify-between mb-4">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-300">Agent usage</h2>
                <span class="text-xs text-slate-500">rolling 24h / 7d</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <% for a in agents %>
                    <% let daily_used = usage_day[a] ?? 0 %>
                    <% let daily_cap = limits[a]["daily"] %>
                    <% let weekly_used = usage_week[a] ?? 0 %>
                    <% let weekly_cap = limits[a]["weekly"] %>
                    <article class="rounded-xl border border-white/10 bg-slate-900/60 p-4 hover-lift card-glow">
                        <header class="flex items-baseline justify-between mb-3">
                            <h3 class="font-mono text-sm gradient-text"><%- a %></h3>
                        </header>
                        <%- partial("home/agent_usage_row", {
                            "label": "today",
                            "used":  daily_used,
                            "cap":   daily_cap
                        }) %>
                        <%- partial("home/agent_usage_row", {
                            "label": "this week",
                            "used":  weekly_used,
                            "cap":   weekly_cap
                        }) %>
                    </article>
                <% end %>
            </div>
        </section>

        <% if projects.length == 0 %>
            <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-8 text-center animate-fade-in">
                <p class="text-amber-300 font-medium">No projects with a <code>tasks/</code> folder under <code><%= root %></code>.</p>
                <p class="mt-2 text-slate-400 text-sm">Create one with <code class="text-amber-300">mkdir &lt;repo&gt;/tasks/todo</code> and refresh.</p>
            </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% for p in projects %>
                <a href="/projects/<%= p["name"] %>" class="group block rounded-2xl glass-card-light p-6 hover-lift card-glow animate-fade-in animate-fade-in-2">
                    <div class="flex items-baseline justify-between mb-4">
                        <h2 class="text-xl font-semibold group-hover:text-indigo-200 transition-colors"><%= p["name"] %></h2>
                        <span class="text-xs text-slate-500 font-mono"><%= p["total"] %> task<%= p["total"] == 1 ? "" : "s" %></span>
                    </div>
                    <div class="grid grid-cols-5 gap-1 text-center text-xs">
                        <% for s in statuses %>
                            <div class="rounded-md bg-slate-900/60 border border-white/5 py-2 group-hover:border-white/10 transition-colors">
                                <div class="font-mono text-base text-white"><%= p["counts"][s] %></div>
                                <div class="text-slate-500 truncate"><%= s %></div>
                            </div>
                        <% end %>
                    </div>
                </a>
            <% end %>
        </div>
    </div>
</div>
