<div class="min-h-screen bg-slate-950 text-white">
    <div class="max-w-6xl mx-auto px-6 py-12">
        <header class="mb-12 flex items-baseline justify-between flex-wrap gap-3">
            <div>
                <h1 class="text-4xl font-bold tracking-tight">Task Orchestrator</h1>
                <p class="mt-2 text-slate-400 font-mono text-sm"><%= root %></p>
            </div>
            <a href="/docs" class="rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors">📖 Docs</a>
        </header>

        <!-- Agent usage tile: today's & this-week's run counts per agent,
             with a progress bar when a limit is configured. -->
        <section class="mb-10 rounded-2xl border border-white/10 bg-white/5 p-6">
            <div class="flex items-baseline justify-between mb-4">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-300">Agent usage</h2>
                <span class="text-xs text-slate-500">rolling 24h / 7d</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <% for a in agents %>
                    <% let daily_used = usage_day[a] ?? 0 %>
                    <% let daily_cap = limits[a]["daily"] %>
                    <% let weekly_used = usage_week[a] ?? 0 %>
                    <% let weekly_cap = limits[a]["weekly"] %>
                    <article class="rounded-xl border border-white/10 bg-slate-900/60 p-4">
                        <header class="flex items-baseline justify-between mb-3">
                            <h3 class="font-mono text-sm text-slate-100"><%- a %></h3>
                        </header>
                        <%- partial("home/agent_usage_row", {
                            "label": "today",
                            "used":  daily_used,
                            "cap":   daily_cap
                        }) %>
                        <%- partial("home/agent_usage_row", {
                            "label": "this week",
                            "used":  weekly_used,
                            "cap":   weekly_cap
                        }) %>
                    </article>
                <% end %>
            </div>
        </section>

        <% if projects.length == 0 %>
            <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-8 text-center">
                <p class="text-amber-300 font-medium">No projects with a <code>tasks/</code> folder under <code><%= root %></code>.</p>
                <p class="mt-2 text-slate-400 text-sm">Create one with <code class="text-amber-300">mkdir &lt;repo&gt;/tasks/todo</code> and refresh.</p>
            </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% for p in projects %>
                <a href="/projects/<%= p["name"] %>" class="group block rounded-2xl border border-white/10 bg-white/5 hover:border-indigo-400/60 hover:bg-white/10 transition-all p-6">
                    <div class="flex items-baseline justify-between mb-4">
                        <h2 class="text-xl font-semibold"><%= p["name"] %></h2>
                        <span class="text-xs text-slate-500 font-mono"><%= p["total"] %> task<%= p["total"] == 1 ? "" : "s" %></span>
                    </div>
                    <div class="grid grid-cols-5 gap-1 text-center text-xs">
                        <% for s in statuses %>
                            <div class="rounded-md bg-slate-900/60 border border-white/5 py-2">
                                <div class="font-mono text-base text-white"><%= p["counts"][s] %></div>
                                <div class="text-slate-500 truncate"><%= s %></div>
                            </div>
                        <% end %>
                    </div>
                </a>
            <% end %>
        </div>
    </div>
</div>
