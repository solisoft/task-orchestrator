<div class="min-h-screen text-white">
    <div class="max-w-6xl mx-auto px-6 py-12">

        <nav class="text-sm text-slate-500 mb-4 animate-fade-in">
            <a href="/" class="hover:text-slate-300 transition-colors">Home</a>
            <span class="mx-2">/</span>
            <span class="text-slate-300">Agents Dashboard</span>
        </nav>

        <header class="mb-12 animate-fade-in">
            <div class="mb-6">
                <h1 class="text-4xl font-bold tracking-tight hero-shimmer">Agents Dashboard</h1>
                <p class="mt-2 text-slate-400 font-mono text-sm"><%= root %></p>
            </div>
            <p class="text-slate-400 text-sm max-w-2xl leading-relaxed">
                Per-project task counts, agent usage, and the entry points into each repo.
                Drop a markdown task spec, queue it, and an agent dispatches it end-to-end inside a fresh git worktree.
            </p>
        </header>

        <section class="mb-8 rounded-xl glass-card p-4 animate-fade-in animate-fade-in-1">
            <div class="flex items-baseline gap-x-3 gap-y-1 flex-wrap">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 shrink-0 mr-2">Usage</h2>
                <% let idx = 0 %>
                <% for a in agents %>
                    <% if idx > 0 %><span class="text-slate-700">|</span><% end %>
                    <% let du = usage_day[a] ?? 0 %>
                    <% let dc = limits[a]["daily"] %>
                    <% let wu = usage_week[a] ?? 0 %>
                    <% let wc = limits[a]["weekly"] %>
                    <div class="flex items-center gap-2 text-xs">
                        <span class="gradient-text font-medium uppercase tracking-wide"><%= a %></span>
                        <% let du_over = dc > 0 and du >= dc %>
                        <span class="font-mono <%= du_over ? "text-red-300" : "text-slate-300" %>"><%= du %><% if dc > 0 %><span class="text-slate-500">/<%= dc %></span><% end %></span>
                        <span class="text-slate-600">24h</span>
                        <% if wc > 0 %>
                            <% let wu_over = wu >= wc %>
                            <span class="font-mono <%= wu_over ? "text-red-300" : "text-slate-400" %>"><%= wu %>/<%= wc %></span>
                            <span class="text-slate-600">7d</span>
                        <% end %>
                    </div>
                    <% idx = idx + 1 %>
                <% end %>
            </div>
        </section>

        <% if projects.length == 0 %>
            <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-8 text-center animate-fade-in">
                <p class="text-amber-300 font-medium">No projects with a <code>tasks/</code> folder under <code><%= root %></code>.</p>
                <p class="mt-2 text-slate-400 text-sm">Create one with <code class="text-amber-300">mkdir &lt;repo&gt;/tasks/todo</code> and refresh.</p>
            </div>
        <% else %>
            <div class="rounded-xl overflow-hidden border border-white/10 animate-fade-in animate-fade-in-2">
                <div class="grid items-center bg-slate-900/80 border-b border-white/5 px-5 py-2.5 text-xs text-slate-400 uppercase tracking-wider" style="grid-template-columns: 1fr 5rem repeat(<%= statuses.length() %>, 5rem) 5rem">
                    <span>Project</span>
                    <span class="text-center text-fuchsia-300/80">Features</span>
                    <% for s in statuses %>
                        <span class="text-center"><%= s %></span>
                    <% end %>
                    <span class="text-center text-amber-400/80">Follow-up</span>
                </div>
                <% for p in projects %>
                    <div class="grid items-center px-5 py-3 border-b border-white/5 last:border-b-0 hover:bg-white/5 transition-colors group" style="grid-template-columns: 1fr 5rem repeat(<%= statuses.length() %>, 5rem) 5rem">
                        <a href="/projects/<%= p["name"] %>" class="text-sm font-medium group-hover:text-indigo-200 transition-colors truncate pr-2"><%= p["name"] %></a>
                        <% let fcnt = features_by_project[p["name"]] ?? 0 %>
                        <a href="/features?project=<%= p["name"] %>" class="text-center text-sm font-mono transition-colors <%= fcnt > 0 ? "text-fuchsia-300 hover:text-fuchsia-200" : "text-slate-600 hover:text-slate-400" %>" title="<%= fcnt %> feature briefs">
                            <% if fcnt > 0 %><%= fcnt %><% else %>&middot;<% end %>
                        </a>
                        <% for s in statuses %>
                            <% let cnt = p["counts"][s] ?? 0 %>
                            <a href="/projects/<%= p["name"] %>" class="text-center text-sm font-mono <%= cnt > 0 ? "text-white" : "text-slate-600" %>"><%= cnt %></a>
                        <% end %>
                        <% let fup = follow_up_by_project[p["name"]] ?? 0 %>
                        <a href="/projects/<%= p["name"] %>" class="text-center text-sm font-mono <%= fup > 0 ? "text-amber-300" : "text-slate-600" %>"><% if fup > 0 %><%= fup %><% else %>&middot;<% end %></a>
                    </div>
                <% end %>
            </div>
        <% end %>

    </div>
</div>
