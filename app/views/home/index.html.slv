<div class="min-h-screen text-white">
    <div class="max-w-6xl mx-auto px-6 py-12">

        <header class="mb-12 animate-fade-in">
            <div class="flex items-baseline justify-between flex-wrap gap-3 mb-6">
                <div>
                    <h1 class="text-4xl font-bold tracking-tight hero-shimmer">Task Orchestrator</h1>
                    <p class="mt-2 text-slate-400 font-mono text-sm"><%= root %></p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/plans" class="rounded-lg glass-card-light hover:bg-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">Plans</a>
                    <a href="/settings" class="rounded-lg glass-card-light hover:bg-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">Settings</a>
                    <a href="/docs" class="rounded-lg glass-card-light hover:bg-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">Docs</a>
                </div>
            </div>
            <p class="text-slate-400 text-sm max-w-2xl leading-relaxed">
                Drop a markdown task spec, queue it, and watch a Claude Code agent dispatch it end-to-end inside a fresh git worktree.
            </p>
        </header>

        <section class="mb-8 rounded-xl glass-card p-4 animate-fade-in animate-fade-in-1">
            <div class="flex items-baseline gap-x-3 gap-y-1 flex-wrap">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 shrink-0 mr-2">Usage</h2>
                <% let idx = 0 %>
                <% for a in agents %>
                    <% if idx > 0 %><span class="text-slate-700">|</span><% end %>
                    <% let du = usage_day[a] ?? 0 %>
                    <% let dc = limits[a]["daily"] %>
                    <% let wu = usage_week[a] ?? 0 %>
                    <% let wc = limits[a]["weekly"] %>
                    <div class="flex items-center gap-2 text-xs">
                        <span class="gradient-text font-medium uppercase tracking-wide"><%= a %></span>
                        <% let du_over = dc > 0 and du >= dc %>
                        <span class="font-mono <%= du_over ? "text-red-300" : "text-slate-300" %>"><%= du %><% if dc > 0 %><span class="text-slate-500">/<%= dc %></span><% end %></span>
                        <span class="text-slate-600">24h</span>
                        <% if wc > 0 %>
                            <% let wu_over = wu >= wc %>
                            <span class="font-mono <%= wu_over ? "text-red-300" : "text-slate-400" %>"><%= wu %>/<%= wc %></span>
                            <span class="text-slate-600">7d</span>
                        <% end %>
                    </div>
                    <% idx = idx + 1 %>
                <% end %>
            </div>
        </section>

        <% if projects.length == 0 %>
            <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-8 text-center animate-fade-in">
                <p class="text-amber-300 font-medium">No projects with a <code>tasks/</code> folder under <code><%= root %></code>.</p>
                <p class="mt-2 text-slate-400 text-sm">Create one with <code class="text-amber-300">mkdir &lt;repo&gt;/tasks/todo</code> and refresh.</p>
            </div>
        <% else %>
            <div class="rounded-xl overflow-hidden border border-white/10 animate-fade-in animate-fade-in-2">
                <div class="grid items-center bg-slate-900/80 border-b border-white/5 px-5 py-2.5 text-xs text-slate-400 uppercase tracking-wider" style="grid-template-columns: 1fr repeat(<%= statuses.length() %>, 5rem)">
                    <span>Project</span>
                    <% for s in statuses %>
                        <span class="text-center"><%= s %></span>
                    <% end %>
                </div>
                <% for p in projects %>
                    <a href="/projects/<%= p["name"] %>" class="grid items-center px-5 py-3 border-b border-white/5 last:border-b-0 hover:bg-white/5 transition-colors group" style="grid-template-columns: 1fr repeat(<%= statuses.length() %>, 5rem)">
                        <span class="text-sm font-medium group-hover:text-indigo-200 transition-colors truncate pr-2"><%= p["name"] %></span>
                        <% for s in statuses %>
                            <% let cnt = p["counts"][s] ?? 0 %>
                            <span class="text-center text-sm font-mono <%= cnt > 0 ? "text-white" : "text-slate-600" %>"><%= cnt %></span>
                        <% end %>
                    </a>
                <% end %>
            </div>
        <% end %>

    </div>
</div>
