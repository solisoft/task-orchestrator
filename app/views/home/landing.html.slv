<div class="min-h-screen text-white relative overflow-hidden">
  <div class="login-orb login-orb-1"></div>
  <div class="login-orb login-orb-2"></div>
  <div class="login-orb login-orb-3"></div>

  <nav class="relative max-w-7xl mx-auto px-6 py-5 flex items-center justify-between animate-fade-in">
    <a href="/" class="inline-flex items-center gap-2.5 group">
      <span class="relative flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-fuchsia-500 shadow-lg shadow-indigo-500/30">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </span>
      <span class="text-base font-semibold tracking-tight">Task Orchestrator</span>
    </a>
    <div class="flex items-center gap-1.5">
      <a href="/features" class="hidden sm:inline-block rounded-lg text-slate-300 hover:text-white text-sm font-medium px-3 py-2 transition-colors">Features</a>
      <a href="/agents-dashboard" class="hidden sm:inline-block rounded-lg text-slate-300 hover:text-white text-sm font-medium px-3 py-2 transition-colors">Dashboard</a>
      <a href="/docs" class="hidden sm:inline-block rounded-lg text-slate-300 hover:text-white text-sm font-medium px-3 py-2 transition-colors">Docs</a>
      <% if current_user != nil %>
        <a href="/agents-dashboard" class="rounded-lg bg-gradient-to-r from-indigo-500 to-fuchsia-500 hover:from-indigo-400 hover:to-fuchsia-400 text-white text-sm font-semibold px-4 py-2 transition-all btn-glow shadow-lg shadow-indigo-500/25">Open dashboard &rarr;</a>
      <% else %>
        <a href="/login" class="rounded-lg bg-gradient-to-r from-indigo-500 to-fuchsia-500 hover:from-indigo-400 hover:to-fuchsia-400 text-white text-sm font-semibold px-4 py-2 transition-all btn-glow shadow-lg shadow-indigo-500/25">Sign in &rarr;</a>
      <% end %>
    </div>
  </nav>

  <section class="relative max-w-5xl mx-auto px-6 pt-12 lg:pt-24 pb-16 text-center">
    <div class="inline-flex items-center gap-2 rounded-full bg-indigo-500/10 border border-indigo-400/20 px-3 py-1 text-xs font-medium text-indigo-300 mb-6 animate-fade-in">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-400"></span>
      </span>
      <span>Multi-agent orchestration, built for product teams</span>
    </div>

    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] mb-6 animate-fade-in animate-fade-in-1">
      <span class="hero-shimmer">From product brief</span><br>
      <span class="gradient-text">to shipped PR.</span>
    </h1>
    <p class="text-lg sm:text-xl text-slate-400 leading-relaxed max-w-2xl mx-auto mb-10 animate-fade-in animate-fade-in-2">
      Write the brief once. Watch agents fan it into linked tasks, spin up
      isolated worktrees, and open PRs &mdash; while your team discusses,
      reviews, and merges in one place.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mb-10 animate-fade-in animate-fade-in-3">
      <a href="/features/new" class="cta-shimmer inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-indigo-500 to-fuchsia-500 hover:from-indigo-400 hover:to-fuchsia-400 text-white text-base font-semibold px-6 py-3 transition-all btn-glow shadow-xl shadow-indigo-500/25">
        Start a brief
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="/agents-dashboard" class="inline-flex items-center gap-2 rounded-lg glass-card-light hover:bg-white/10 text-slate-200 hover:text-white text-base font-medium px-6 py-3 transition-colors">
        See the dashboard
      </a>
    </div>

    <div class="inline-flex items-center gap-6 text-xs text-slate-500 animate-fade-in animate-fade-in-4">
      <div class="flex items-center gap-1.5">
        <span class="font-mono text-base text-slate-300 font-semibold"><%= project_count %></span>
        <span>project<%= project_count == 1 ? "" : "s" %></span>
      </div>
      <span class="w-px h-4 bg-white/10"></span>
      <div class="flex items-center gap-1.5">
        <span class="font-mono text-base text-fuchsia-300 font-semibold"><%= feature_total %></span>
        <span>brief<%= feature_total == 1 ? "" : "s" %></span>
      </div>
      <span class="w-px h-4 bg-white/10"></span>
      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 dot-pulse"></span>
        <span>agents idle</span>
      </div>
    </div>
  </section>

  <section class="relative max-w-6xl mx-auto px-6 pb-20">
    <div class="grid md:grid-cols-3 gap-5">

      <div class="feature-card rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-1">
        <div class="inline-flex w-11 h-11 rounded-xl bg-indigo-500/15 border border-indigo-400/25 items-center justify-center text-indigo-300 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-100 mb-2">Briefs, not tickets</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Capture the product story in markdown &mdash; the why, the UX, the acceptance criteria. Discuss inline with your team before a single task is written.
        </p>
      </div>

      <div class="feature-card rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-2">
        <div class="inline-flex w-11 h-11 rounded-xl bg-fuchsia-500/15 border border-fuchsia-400/25 items-center justify-center text-fuchsia-300 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-100 mb-2">
          One-click fan-out <span class="ai-sparkle">&#x2728;</span>
        </h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Hit <em>Generate Tasks</em> and the plan agent breaks the brief into 3&ndash;7 focused, actionable tasks, each linked back to the parent feature.
        </p>
      </div>

      <div class="feature-card rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-3">
        <div class="inline-flex w-11 h-11 rounded-xl bg-emerald-500/15 border border-emerald-400/25 items-center justify-center text-emerald-300 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-100 mb-2">Worktrees &amp; PRs, live</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Agents work in isolated git worktrees, open PRs, and the board reflects every step &mdash; queue, run, review, merge.
        </p>
      </div>

    </div>
  </section>

  <section class="relative max-w-5xl mx-auto px-6 pb-24">
    <div class="rounded-3xl glass-card p-8 lg:p-12 text-center relative overflow-hidden animate-fade-in">
      <div class="absolute -top-24 -left-12 w-72 h-72 rounded-full bg-indigo-500/15 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-12 w-72 h-72 rounded-full bg-fuchsia-500/15 blur-3xl pointer-events-none"></div>
      <h2 class="relative text-3xl lg:text-4xl font-bold mb-3">
        <span class="gradient-text">Ready when you are.</span>
      </h2>
      <p class="relative text-slate-400 max-w-xl mx-auto mb-8">
        Drop a brief, generate tasks, and let agents pick them up. The dashboard tracks every run end-to-end.
      </p>
      <div class="relative flex flex-wrap items-center justify-center gap-3">
        <a href="/features/new" class="cta-shimmer inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-indigo-500 to-fuchsia-500 hover:from-indigo-400 hover:to-fuchsia-400 text-white text-base font-semibold px-6 py-3 transition-all btn-glow shadow-xl shadow-indigo-500/25">
          Write your first brief
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/agents-dashboard" class="inline-flex items-center gap-2 rounded-lg glass-card-light hover:bg-white/10 text-slate-200 hover:text-white text-base font-medium px-6 py-3 transition-colors">
          Open dashboard
        </a>
      </div>
    </div>
  </section>

  <footer class="relative max-w-7xl mx-auto px-6 py-8 flex items-center justify-between text-xs text-slate-600 border-t border-white/5">
    <span class="font-mono">Task Orchestrator</span>
    <span class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 dot-pulse"></span>
      <span>powered by Soli</span>
    </span>
  </footer>
</div>
