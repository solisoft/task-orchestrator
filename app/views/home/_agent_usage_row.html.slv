<% let pct = (cap > 0) ? (used * 100) / cap : 0 %>
<% let over = (cap > 0) and (used >= cap) %>
<% let bar_class = over ? "bg-red-500" : (pct >= 75 ? "bg-amber-400" : "bg-emerald-400") %>
<% let pct_clamped = pct > 100 ? 100 : pct %>
<div class="mb-2 last:mb-0">
  <div class="flex items-baseline justify-between text-xs mb-1">
    <span class="text-slate-400"><%= label %></span>
    <span class="font-mono <%= over ? "text-red-300" : "text-slate-200" %>">
      <%= used %><% if cap > 0 %><span class="text-slate-500"> / <%= cap %></span><% end %>
    </span>
  </div>
  <% if cap > 0 %>
    <div class="h-1.5 w-full rounded-full bg-slate-800 overflow-hidden">
      <div class="<%= bar_class %> h-full rounded-full transition-all" style="width: <%= pct_clamped %>%"></div>
    </div>
  <% end %>
</div>
