<% _stage = locals["stage"] ?? "shape" %>
<% _stages = ["shape", "bet", "build", "ship"] %>
<% _idx = 0 %>
<% _cur = -1 %>
<% for s in _stages %>
  <% if s == _stage %><% _cur = _idx %><% end %>
  <% _idx = _idx + 1 %>
<% end %>
<div class="inline-flex items-center gap-1 text-[10px] uppercase tracking-wider text-slate-500" title="Pipeline: <%= h(_stage) %>">
  <% _idx = 0 %>
  <% for s in _stages %>
    <% _done   = _idx < _cur %>
    <% _active = _idx == _cur %>
    <% if _idx > 0 %>
      <span class="w-3 h-px <%= _done ? "bg-emerald-400/50" : "bg-slate-700" %>"></span>
    <% end %>
    <span class="inline-flex items-center gap-1">
      <span class="inline-block w-1.5 h-1.5 rounded-full <%= _active ? "bg-indigo-400 ring-2 ring-indigo-400/30" : (_done ? "bg-emerald-400/70" : "bg-slate-700") %>"></span>
      <span class="<%= _active ? "text-indigo-300 font-semibold" : (_done ? "text-emerald-300/70" : "text-slate-600") %>"><%= h(s) %></span>
    </span>
    <% _idx = _idx + 1 %>
  <% end %>
</div>
