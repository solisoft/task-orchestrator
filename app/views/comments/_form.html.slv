<form hx-post="/features/<%= feature._key %>/comments"
      hx-target="#comments-thread"
      hx-swap="outerHTML"
      hx-indicator="#comment-spinner">
  <textarea name="body" rows="3" required
            class="w-full rounded-xl bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none p-3 font-mono text-sm text-slate-100 resize-y mb-2"
            placeholder="Write a comment... (Markdown supported)"></textarea>
  <div class="flex justify-between items-center">
    <span class="text-xs text-slate-500">Posting as <%= current_user.email ?? current_user.display_name ?? "" %></span>
    <button type="submit" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors">
      Post Comment
      <span id="comment-spinner" class="htmx-indicator ml-1">...</span>
    </button>
  </div>
</form>
