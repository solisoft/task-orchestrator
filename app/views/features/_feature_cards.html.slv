<%
  # HTMX load-more response: feature cards to append + OOB load-more toggle.
  # Locals: features, project, new_offset, has_more, total, q
  let _pkey = project.slugify()
%>
<% for _feature in features %>
  <a href="/features/<%= _feature._key %>" class="feature-card block rounded-xl glass-card p-4">
    <div class="flex items-baseline justify-between gap-3 mb-1.5">
      <h3 class="text-base font-semibold text-slate-100 truncate"><%= _feature.title %></h3>
      <span class="status-pill status-pill-<%= _feature.status %>"><%= _feature.status %></span>
    </div>
    <% if _feature.description != nil and _feature.description != "" %>
      <p class="text-sm text-slate-400 line-clamp-2 leading-relaxed"><%= truncate_text(_feature.description, 200, "…") %></p>
    <% else %>
      <p class="text-sm text-slate-600 italic">No description yet</p>
    <% end %>
    <% let _created = format_date(_feature.created_at) %>
    <% let _author = (_feature.author ?? "").trim() %>
    <% if _created != "" or _author != "" %>
      <p class="text-xs text-slate-500 mt-2">
        <% if _created != "" %>Created <%= _created %><% end %>
        <% if _author != "" %>
          <% if _created != "" %> <% end %>by <%= _author %>
        <% end %>
      </p>
    <% end %>
  </a>
<% end %>
<% if has_more %>
  <div id="lm-<%= _pkey %>" hx-swap-oob="true" class="mt-3">
    <button type="button"
            hx-get="/features?project=<%= project %>&offset=<%= new_offset %><%= q != "" ? "&q=" + h(q) : "" %>"
            hx-target="#features-<%= _pkey %>"
            hx-swap="beforeend"
            class="w-full rounded-lg bg-slate-700/30 text-slate-400 border border-slate-500/20 px-4 py-2 text-sm font-medium hover:bg-slate-600/30 hover:text-slate-300 transition-colors">
      Load more (<%= total - new_offset %> remaining)
    </button>
  </div>
<% else %>
  <div id="lm-<%= _pkey %>" hx-swap-oob="true"></div>
<% end %>
