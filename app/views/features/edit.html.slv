<div class="min-h-screen text-white">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <%- partial("shared/breadcrumbs", { "crumbs": [
      { "label": "Projects",      "href": "/projects" },
      { "label": feature.project, "href": "/projects/" + feature.project },
      { "label": feature.title,   "href": "/features/" + feature._key },
      { "label": "Edit",          "href": "" }
    ] }) %>

    <h1 class="text-2xl font-bold mb-6 animate-fade-in">Edit Feature Brief</h1>

    <% if feature._errors %>
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 text-red-200 text-sm px-4 py-3 mb-4">
        <% for field, errs in feature._errors %>
          <div><strong><%= field %>:</strong> <%= errs.join(", ") %></div>
        <% end %>
      </div>
    <% end %>

    <%- partial("features/form", {
      "feature":            feature,
      "projects":           projects,
      "claude_options":     claude_options,
      "opencode_options":   opencode_options,
      "default_plan_model": default_plan_model
    }) %>
  </div>
</div>
