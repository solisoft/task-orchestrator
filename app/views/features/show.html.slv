<div class="min-h-screen text-white">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <nav class="text-sm text-slate-500 mb-4 animate-fade-in">
      <a href="/" class="hover:text-slate-300 transition-colors">All projects</a>
      <span class="mx-2">/</span>
      <a href="/features" class="hover:text-slate-300">Features</a>
      <span class="mx-2">/</span>
      <span class="text-slate-300"><%= feature.title %></span>
    </nav>

    <header class="mb-6 flex items-baseline justify-between flex-wrap gap-3 animate-fade-in">
      <div>
        <h1 class="text-2xl font-bold gradient-text"><%= feature.title %></h1>
        <p class="text-xs text-slate-500 mt-1 font-mono"><%= feature.project %></p>
        <p class="text-xs text-slate-500 mt-1">
          Status:
          <span class="inline-block rounded-md bg-indigo-500/20 text-indigo-300 px-2 py-0.5 text-xs font-medium ml-1"><%= feature.status %></span>
        </p>
      </div>
      <div class="flex gap-2">
        <a href="/features/<%= feature._key %>/edit" class="rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors">Edit</a>
        <% if feature.status == "draft" or feature.status == "ready" %>
          <button type="button"
                  hx-post="/features/<%= feature._key %>/generate_tasks"
                  hx-target="#generate-tasks-area"
                  hx-swap="innerHTML"
                  hx-indicator="#generate-spinner"
                  class="rounded-lg bg-emerald-500/90 hover:bg-emerald-400 text-white text-sm font-medium px-4 py-2 transition-colors">
            Generate Tasks
            <span id="generate-spinner" class="htmx-indicator ml-1">...</span>
          </button>
        <% end %>
        <form method="post" action="/features/<%= feature._key %>?_method=delete" onsubmit="return confirm('Delete this feature?')">
          <button type="submit" class="rounded-lg bg-red-500/20 hover:bg-red-500/30 text-red-300 hover:text-red-200 text-sm font-medium px-4 py-2 transition-colors">Delete</button>
        </form>
      </div>
    </header>

    <% if feature.description != nil and feature.description != "" %>
      <div class="rounded-xl glass-card p-6 mb-6">
        <h2 class="text-sm font-semibold text-slate-300 mb-3 uppercase tracking-wider">Brief</h2>
        <article class="task-md text-sm">
          <%- Markdown.to_safe_html(feature.description) %>
        </article>
      </div>
    <% end %>

    <div id="generate-tasks-area"></div>

    <% if tasks.length() > 0 %>
      <div class="rounded-xl glass-card p-6 mb-6">
        <h2 class="text-sm font-semibold text-slate-300 mb-3 uppercase tracking-wider">Linked Tasks</h2>
        <div class="space-y-2">
          <% for task in tasks %>
            <a href="/projects/<%= task.project %>/tasks/<%= task.slug %>"
               hx-get="/projects/<%= task.project %>/tasks/<%= task.slug %>/sidebar"
               hx-target="#task-sidebar-body"
               hx-swap="innerHTML"
               onclick="openTaskSidebar()"
               class="block rounded-lg bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-2.5 transition-colors group cursor-pointer">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-sm text-slate-200 group-hover:text-indigo-200 transition-colors font-medium"><%= task.title %></span>
                <span class="text-xs rounded-md bg-slate-700/70 text-slate-400 px-2 py-0.5 font-mono"><%= task.status %></span>
              </div>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if comments.length() > 0 %>
      <div class="rounded-xl glass-card p-6 mb-6" id="comments-list-area">
        <h2 class="text-sm font-semibold text-slate-300 mb-3 uppercase tracking-wider">Comments</h2>
        <%- partial("comments/list", { "comments": comments }) %>
      </div>
    <% end %>

    <% if current_user != nil %>
      <div class="rounded-xl glass-card p-6" id="comment-form-area">
        <h2 class="text-sm font-semibold text-slate-300 mb-3 uppercase tracking-wider">Add Comment</h2>
        <%- partial("comments/form", { "feature": feature, "current_user": current_user }) %>
      </div>
    <% end %>
  </div>
</div>

<!-- Sliding right-side panel for a linked task. The anchors above swap
     the task fragment into `#task-sidebar-body` via HTMX while
     `openTaskSidebar()` toggles the overlay visible; the backdrop and
     Escape key both call `closeTaskSidebar()`. -->
<div id="task-sidebar-overlay" class="task-sidebar-overlay" aria-hidden="true">
  <div class="task-sidebar-backdrop" onclick="closeTaskSidebar()"></div>
  <aside class="task-sidebar" role="dialog" aria-modal="true" aria-label="Task details">
    <button type="button" class="task-sidebar-close" onclick="closeTaskSidebar()" aria-label="Close task panel">&times;</button>
    <div id="task-sidebar-body" class="task-sidebar-body">
      <p class="text-sm text-slate-500 italic">Loading…</p>
    </div>
  </aside>
</div>

<script>
  function openTaskSidebar() {
    var el = document.getElementById('task-sidebar-overlay');
    if (!el) return;
    el.classList.add('is-open');
    el.setAttribute('aria-hidden', 'false');
    document.body.classList.add('task-sidebar-open');
  }
  function closeTaskSidebar() {
    var el = document.getElementById('task-sidebar-overlay');
    if (!el) return;
    el.classList.remove('is-open');
    el.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('task-sidebar-open');
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeTaskSidebar();
  });
</script>
