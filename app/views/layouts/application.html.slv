<% let _theme       = theme ?? "dark" %>
<% let _theme_vars  = locals["theme_css_vars"] ?? {} %>
<% let _theme_class = locals["theme_class"] ?? (_theme == "light" ? "light" : "dark") %>
<!DOCTYPE html>
<html lang="en" class="h-full <%= _theme_class %>" data-theme="<%= h(_theme) %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Soli App</title>

    <!-- The active theme is decided server-side from Setting.current_theme()
         so first paint already matches the saved preference. Mirror it
         into localStorage so client-side helpers (theme.js toggle) stay
         in sync across tabs — read the value from `data-theme` rather
         than templating into a JS string literal, so a preset name with
         a `"` in it can't break the script. -->
    <script>
      (function () {
        try {
          var t = document.documentElement.getAttribute("data-theme") || "dark";
          localStorage.setItem("theme", t);
        } catch (e) {}
      })();
    </script>

    <!-- Tailwind CSS (compiled) -->
    <link rel="stylesheet" href="<%= public_path("css/application.css") %>">
    <!-- Light-theme overrides (no-op when <html> lacks `light` class) -->
    <link rel="stylesheet" href="<%= public_path("css/theme-light.css") %>">
    <!-- Preset CSS variable overrides — utility classes opt into these
         vars (see `theme-presets.css`) so picking Dracula / Tokyo Night
         / etc. retints the body and cards without a full per-preset
         stylesheet. Built-in dark/light leave the hash empty, falling
         back to the defaults baked into application.css. -->
    <link rel="stylesheet" href="<%= public_path("css/theme-presets.css") %>">
    <% if _theme_vars.keys().length() > 0 %>
      <style>
        :root {
          <% for k in _theme_vars.keys() %>
            <%= k %>: <%= _theme_vars[k] %>;
          <% end %>
        }
      </style>
    <% end %>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- HTMX for snappy in-place updates on Queue / Save / move actions -->
    <script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>

    <!-- Browser push notifications (registers the service worker on every page) -->
    <script src="<%= public_path("push.js") %>" defer></script>
    <!-- Theme toggle wiring (reads the saved preference, syncs the toggle button) -->
    <script src="<%= public_path("theme.js") %>" defer></script>
    <!-- Custom styled confirm dialog (replaces window.confirm for data-confirm forms) -->
    <script src="<%= public_path("confirm.js") %>" defer></script>
    <!-- Live WebSocket stream client for run / plan / generate-tasks panels -->
    <script src="<%= public_path("run-stream.js") %>" defer></script>
    <style>
      /* HTMX v2 ships no CSS; replicate the canonical indicator pattern. */
      .htmx-indicator { display: none; }
      .htmx-request .htmx-indicator,
      .htmx-request.htmx-indicator { display: inline; }

      /* Hand-rolled markdown styles (no Tailwind typography plugin).
         Colours are bound to CSS variables defined in application.css
         so the block flips automatically with the active theme. */
      .task-md { color: var(--md-text); line-height: 1.65; }
      .task-md h1, .task-md h2, .task-md h3, .task-md h4 { color: var(--md-heading); font-weight: 600; }
      .task-md h2 { font-size: 1.125rem; margin: 1.5rem 0 0.5rem; padding-bottom: 0.25rem; border-bottom: 1px solid var(--md-heading-border); }
      .task-md h3 { font-size: 1rem; margin: 1.25rem 0 0.4rem; }
      .task-md h2:first-child, .task-md h3:first-child { margin-top: 0; }
      .task-md p { margin: 0.5rem 0; }
      .task-md ul, .task-md ol { margin: 0.5rem 0; padding-left: 1.5rem; }
      .task-md ul { list-style: disc; }
      .task-md ol { list-style: decimal; }
      .task-md li { margin: 0.25rem 0; }
      .task-md strong { color: var(--md-strong); font-weight: 600; }
      .task-md em { color: var(--md-em); font-style: italic; }
      .task-md code { color: var(--md-code-text); background: var(--md-code-bg); padding: 0.1em 0.35em; border-radius: 0.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.9em; }
      .task-md pre { background: var(--md-pre-bg); border: 1px solid var(--md-pre-border); border-radius: 0.5rem; padding: 0.75rem 1rem; overflow-x: auto; margin: 0.75rem 0; }
      .task-md pre code { background: transparent; padding: 0; color: var(--md-pre-text); }
      .task-md a { color: var(--md-link); text-decoration: underline; text-underline-offset: 2px; }
      .task-md a:hover { color: var(--md-link-hover); }
      .task-md blockquote { border-left: 3px solid var(--md-blockquote-border); padding-left: 1rem; margin: 0.75rem 0; color: var(--md-blockquote-text); }
      .task-md table { border-collapse: collapse; margin: 0.75rem 0; }
      .task-md th, .task-md td { border: 1px solid var(--md-table-border); padding: 0.4rem 0.75rem; }
      .task-md th { background: var(--md-table-head-bg); font-weight: 600; }
      .task-md hr { border: 0; border-top: 1px solid var(--md-hr-border); margin: 1rem 0; }
    </style>
</head>
<body class="min-h-full text-slate-900 dark:text-white font-sans antialiased gradient-mesh" style="font-family: 'Space Grotesk', system-ui, sans-serif">
    <div class="gradient-accent-bar"></div>
    <% if !(locals["hide_header"] ?? false) %>
      <%- partial("layouts/header", { "current_user": locals["current_user"] ?? nil }) %>
    <% end %>
    <%= yield %>
</body>
</html>
