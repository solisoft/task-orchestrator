<% let token = status == nil ? nil : status["status"] %>
<% let pill = task_status_pill(token) %>
<% let polling = token != nil and not token.starts_with("done:") and not token.starts_with("failed:") %>
<% let elapsed = status == nil ? "" : task_format_elapsed(status["at"]) %>
<% let todo_list = todos ?? [] %>

<div id="run-panel"
  <% if polling %>
    hx-get="/projects/<%= project["name"] %>/tasks/<%= slug %>/run/log"
    hx-trigger="every 2s"
    hx-swap="outerHTML"
  <% end %>
>
  <!-- status pill row -->
  <div class="flex items-center gap-3 mb-4 flex-wrap">
    <span class="inline-flex items-center gap-2 rounded-full border <%= task_status_pill_classes(pill["tone"]) %> px-3 py-1 text-sm font-medium">
      <% if pill["tone"] == "amber" %>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
      <% else %>
        <span class="text-base leading-none"><%= pill["icon"] %></span>
      <% end %>
      <%= pill["label"] %>
    </span>

    <% if elapsed != "" %>
      <span class="text-xs text-slate-500 font-mono">⏱ <%= elapsed %></span>
    <% end %>

    <% if token != nil and token.starts_with("failed:") %>
      <form method="post"
            action="/projects/<%= project["name"] %>/tasks/<%= slug %>/run/resume"
            class="inline ml-auto">
        <button type="submit"
                class="inline-flex items-center gap-1.5 rounded-full bg-amber-400/15 hover:bg-amber-400/25 text-amber-200 hover:text-amber-100 border border-amber-400/30 px-3 py-1 text-sm font-medium transition-colors"
                title="Re-launch this run in its existing worktree, keeping any uncommitted edits">
          <span class="text-base leading-none">↻</span>
          Continue
        </button>
      </form>
    <% end %>

    <% if pr_url != nil %>
      <a href="<%= pr_url %>" target="_blank" rel="noopener" class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-300 hover:text-indigo-200 border border-indigo-400/30 px-3 py-1 text-sm font-medium transition-colors">
        Open PR
        <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor"><path d="M3 3v10h10V8h1v6H2V2h6v1H3zm6.5 0h3.5v3.5h-1V4.7L8.4 9.3l-.7-.7L12.3 4H9.5V3z"/></svg>
      </a>
    <% end %>
  </div>

  <!-- log + plan: log gets 2/3 on lg+, plan gets 1/3; they stack on smaller screens. -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-start">
    <!-- log body -->
    <!-- flex-col-reverse anchors the (single) <pre> child to the visual
         bottom of the container. When the pre's content overflows, the
         browser's natural scroll position is at the bottom (newest lines
         visible); scrolling up reveals older content. No JS, no
         visibility-toggle flicker, no fight with htmx's swap timing —
         the layout itself does the work. -->
    <div id="run-log" class="lg:col-span-2 flex flex-col-reverse rounded-xl bg-slate-950/80 border border-white/10 max-h-[65vh] overflow-y-auto">
      <% if tail == "" %>
        <p class="font-mono text-xs text-slate-600 p-6 text-center italic">no log yet — task hasn't been queued</p>
      <% else %>
        <pre class="font-mono text-xs leading-relaxed p-4 whitespace-pre-wrap m-0"><% for line in tail.split("\n") %><span class="block <%= task_log_line_class(line) %>"><%= line %></span><% end %></pre>
      <% end %>
    </div>

    <!-- plan / todo panel — pulled live from the agent's TodoWrite stream. -->
    <aside id="run-plan" class="rounded-xl bg-slate-900/60 border border-white/10 p-4 max-h-[65vh] overflow-y-auto">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3 flex items-center justify-between">
        <span>Plan</span>
        <% if todo_list.length() > 0 %>
          <span class="text-slate-600 normal-case font-mono text-[10px]"><%= todo_list.length() %></span>
        <% end %>
      </h3>
      <% if todo_list.length() == 0 %>
        <p class="text-xs text-slate-600 italic">no plan yet — agent hasn't called TodoWrite</p>
      <% else %>
        <ol class="space-y-1.5 text-sm">
          <% for todo in todo_list %>
            <% let chrome = task_todo_chrome(todo["status"]) %>
            <li class="flex gap-2 leading-snug">
              <span class="font-mono text-xs w-3 shrink-0 mt-0.5 <%= chrome["classes"] %>"><%= chrome["icon"] %></span>
              <span class="<%= chrome["classes"] %>"><%= todo["content"] ?? "" %></span>
            </li>
          <% end %>
        </ol>
      <% end %>
    </aside>
  </div>
</div>
