<% let token = status == nil ? nil : status["status"] %>
<% let pill = task_status_pill(token) %>
<% let polling = token != nil and not token.starts_with("done:") and not token.starts_with("failed:") %>
<% let elapsed = status == nil ? "" : task_format_elapsed(status["at"]) %>

<div id="run-panel"
  <% if polling %>
    hx-get="/projects/<%= project["name"] %>/tasks/<%= slug %>/run/log"
    hx-trigger="every 2s"
    hx-swap="outerHTML"
    hx-on::before-swap="window.__taskOrchScroll = (function(p){ if(!p) return null; return { fromBottom: p.scrollHeight - p.scrollTop - p.clientHeight }; })(document.querySelector('#run-log'))"
  <% end %>
>
  <!-- status pill row -->
  <div class="flex items-center gap-3 mb-4 flex-wrap">
    <span class="inline-flex items-center gap-2 rounded-full border <%= task_status_pill_classes(pill["tone"]) %> px-3 py-1 text-sm font-medium">
      <% if pill["tone"] == "amber" %>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
      <% else %>
        <span class="text-base leading-none"><%= pill["icon"] %></span>
      <% end %>
      <%= pill["label"] %>
    </span>

    <% if elapsed != "" %>
      <span class="text-xs text-slate-500 font-mono">⏱ <%= elapsed %></span>
    <% end %>

    <% if pr_url != nil %>
      <a href="<%= pr_url %>" target="_blank" rel="noopener" class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-300 hover:text-indigo-200 border border-indigo-400/30 px-3 py-1 text-sm font-medium transition-colors">
        Open PR
        <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor"><path d="M3 3v10h10V8h1v6H2V2h6v1H3zm6.5 0h3.5v3.5h-1V4.7L8.4 9.3l-.7-.7L12.3 4H9.5V3z"/></svg>
      </a>
    <% end %>
  </div>

  <!-- log body -->
  <!-- `invisible` hides the panel until the inline script below has set
       scrollTop, killing the load-then-snap flash that was visible on
       every poll (each outerHTML swap creates a fresh #run-log at
       scrollTop=0 — without this, the user sees the top of the log for
       one frame before the script jumps it to the bottom). -->
  <div id="run-log" class="invisible rounded-xl bg-slate-950/80 border border-white/10 max-h-[65vh] overflow-y-auto">
    <% if tail == "" %>
      <p class="font-mono text-xs text-slate-600 p-6 text-center italic">no log yet — task hasn't been queued</p>
    <% else %>
      <pre class="font-mono text-xs leading-relaxed p-4 whitespace-pre-wrap m-0"><% for line in tail.split("\n") %><span class="block <%= task_log_line_class(line) %>"><%= line %></span><% end %></pre>
    <% end %>
  </div>

  <!-- Inside #run-panel so the outerHTML swap re-executes the script
       on every poll. (When this lived outside the panel, htmx ran it
       once on initial render, then never again — leaving every
       post-swap #run-log stuck with the `invisible` class.) -->
  <script>
  (function () {
    var el = document.getElementById('run-log');
    if (!el) return;
    // window.__taskOrchScroll is captured by hx-on::before-swap on
    // #run-panel before the swap replaces this element. Initial page
    // load: it's undefined → snap to bottom. Subsequent polls: if
    // the user was within 24 px of the bottom we re-snap; otherwise
    // we restore their distance-from-bottom so reading older lines
    // isn't yanked.
    var s = window.__taskOrchScroll;
    if (s == null || s.fromBottom < 24) {
      el.scrollTop = el.scrollHeight;
    } else {
      el.scrollTop = el.scrollHeight - el.clientHeight - s.fromBottom;
    }
    el.classList.remove('invisible');
  })();
  </script>
</div>
