<% let token = status == nil ? nil : status["status"] %>
<% let polling = token != nil and not token.starts_with("done:") and not token.starts_with("failed:") %>
<% let todo_list = todos ?? [] %>
<% let initial_offset = log_size %>
<%
  # When the SSR `tail` was capped (log_size > tail.length), the bytes
  # before the visible tail need to be backfilled on WS connect. The
  # client sends this byte position so the server includes a one-shot
  # `prefix_chunk` in the snapshot, which the client prepends above SSR.
  let prefix_end = log_size - tail.length
%>

<div id="run-panel"
  <% if polling %>
    data-stream-url="/ws/run-stream"
    data-stream-project="<%= project["name"] %>"
    data-stream-slug="<%= slug %>"
    data-stream-log="#run-log"
    data-stream-todos="#run-plan-body"
    data-stream-status="#run-status-row"
    data-stream-offset="<%= initial_offset %>"
    data-stream-prefix-end="<%= prefix_end %>"
    data-stream-tick-ms="300"
  <% end %>
>
  <!-- status pill row. Initial SSR render mirrors `_stream_status` so the
       first paint is correct without waiting for the WS. -->
  <div id="run-status-row" class="flex items-center gap-3 mb-4 flex-wrap">
    <%- render_partial("runs/stream_status", {
      "project": project,
      "slug":    slug,
      "task":    task,
      "status":  status,
      "pr_url":  pr_url
    }) %>
  </div>

  <!-- log + plan: log gets 2/3 on lg+, plan gets 1/3; they stack on smaller screens. -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-start">
    <!-- log body -->
    <!-- The log uses flex-col-reverse so the <pre> child sits at the
         visual bottom of the container; new lines appended by the WS
         client scroll the view downward naturally. -->
    <div id="run-log" class="lg:col-span-2 flex flex-col-reverse rounded-xl neon-terminal max-h-[65vh] overflow-y-auto">
      <% if tail == "" %>
        <p class="font-mono text-xs text-slate-600 p-6 text-center italic">no log yet — task hasn't been queued</p>
      <% else %>
        <pre class="font-mono text-xs leading-relaxed p-4 whitespace-pre-wrap m-0"><% for line in tail.split("\n") %><span class="block <%= task_log_line_class(line) %>"><%= line %></span><% end %></pre>
      <% end %>
    </div>

    <!-- plan / todo panel — pulled live from the agent's TodoWrite stream. -->
    <aside id="run-plan" class="rounded-xl glass-card p-4 max-h-[65vh] overflow-y-auto">
      <div id="run-plan-body">
        <%- render_partial("runs/stream_todos", { "todos": todo_list }) %>
      </div>
    </aside>
  </div>
</div>
