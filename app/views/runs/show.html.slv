<div class="min-h-screen text-white">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%- partial("shared/breadcrumbs", { "crumbs": [
      { "label": "Projects",      "href": "/projects" },
      { "label": project["name"], "href": "/projects/" + project["name"] },
      { "label": slug,            "href": "/projects/" + project["name"] + "/tasks/" + slug },
      { "label": "Run",           "href": "" }
    ] }) %>

    <h1 class="text-2xl font-bold font-mono mb-4 gradient-text animate-fade-in">Agent run · <%= slug %></h1>

    <%- partial("shared/branch", { "branch_info": branch_info, "task": task, "project": project }) %>

    <% _body = (task.body_md ?? "").trim() %>
    <% if _body == "" %>
      <%- render_partial("runs/log", {
        "project": project,
        "task": task,
        "slug": slug,
        "status": status,
        "pr_url": pr_url,
        "tail": tail,
        "log_size": log_size,
        "todos": todos
      }) %>
    <% else %>
      <div class="grid grid-cols-1 xl:grid-cols-[1fr_22rem] gap-6 items-start animate-fade-in animate-fade-in-2">
        <div class="min-w-0">
          <%- render_partial("runs/log", {
            "project": project,
            "task": task,
            "slug": slug,
            "status": status,
            "pr_url": pr_url,
            "tail": tail,
            "log_size": log_size,
            "todos": todos
          }) %>
        </div>
        <aside class="xl:sticky xl:top-6">
          <div class="rounded-xl glass-card border border-white/5 p-5">
            <header class="flex items-center justify-between mb-3">
              <h2 class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Task brief</h2>
              <a href="/projects/<%= h(project["name"]) %>/tasks/<%= h(slug) %>"
                 class="text-xs text-slate-500 hover:text-slate-200 transition-colors">Open ↗</a>
            </header>
            <article class="task-md text-sm">
              <%- Markdown.to_safe_html(_body) %>
            </article>
          </div>
        </aside>
      </div>
    <% end %>
  </div>
</div>
