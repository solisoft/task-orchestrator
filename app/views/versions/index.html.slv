<div class="min-h-screen text-white">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <nav class="text-sm text-slate-500 mb-6 animate-fade-in">
      <a href="/" class="hover:text-slate-300 transition-colors">All projects</a>
      <span class="mx-2">/</span>
      <a href="/projects/<%= h(project["name"]) %>?tab=roadmap" class="hover:text-slate-300 transition-colors"><%= h(project["name"]) %></a>
      <span class="mx-2">/</span>
      <span class="text-slate-300">Versions</span>
    </nav>

    <div class="flex items-center justify-between mb-6 animate-fade-in">
      <h1 class="text-2xl font-bold gradient-text"><%= h(project["name"]) %> — Versions</h1>
      <a href="/projects/<%= h(project["name"]) %>/versions/new"
         class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">+ New cycle</a>
    </div>

    <% if versions.length() == 0 %>
      <div class="rounded-xl glass-card border border-white/5 px-8 py-12 text-center animate-fade-in-1">
        <p class="text-slate-500 text-sm">No cycles yet. Create your first Shape Up cycle.</p>
      </div>
    <% else %>
      <div class="space-y-3 animate-fade-in-1">
        <% for v in versions %>
          <div class="rounded-xl glass-card border border-white/5 px-5 py-3 flex items-center justify-between gap-4">
            <div>
              <span class="text-slate-100 font-medium"><%= h(v.name) %></span>
              <% let _vcn = (v.code_name ?? "").trim() %>
              <% if _vcn != "" %>
                <span class="ml-2 text-xs font-mono text-slate-500 italic">&ldquo;<%= h(_vcn) %>&rdquo;</span>
              <% end %>
              <span class="ml-3 text-xs text-slate-500"><%= h(v.status ?? "planned") %></span>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <a href="/projects/<%= h(project["name"]) %>/versions/<%= h(v._key) %>/edit"
                 class="text-xs text-slate-400 hover:text-slate-200 transition-colors">Edit</a>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
