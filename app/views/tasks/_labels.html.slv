<%# Ticket labels (tags) imported from GitLab / GitHub / Bonfire.
    Locals: labels (array of strings, may be nil), size ("xs" | "sm").
    Priority labels (P0–P3) get a colour so they stand out in a list. %>
<% _labels = labels ?? [] %>
<% if _labels.length > 0 %>
  <span class="inline-flex flex-wrap items-center gap-1 <%= size == "sm" ? "mt-2" : "mt-1" %>">
    <% for _l in _labels %>
      <% _ln = _l.downcase %>
      <% _tone = "bg-slate-700/50 border-white/10 text-slate-300" %>
      <% _tone = "bg-red-500/15 border-red-400/30 text-red-200" if _ln == "p0" || _ln == "p1" %>
      <% _tone = "bg-amber-500/15 border-amber-400/30 text-amber-200" if _ln == "p2" %>
      <% _tone = "bg-sky-500/15 border-sky-400/30 text-sky-200" if _ln == "p3" %>
      <span class="rounded-full border px-2 py-0.5 <%= size == "sm" ? "text-xs" : "text-[10px]" %> leading-none <%= _tone %>"><%= _l %></span>
    <% end %>
  </span>
<% end %>
