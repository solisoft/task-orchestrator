<%
  # `pending_question` carries either the question (with `input.questions`)
  # or the user's submitted answer (just `id` + `value`) until the agent
  # consumes it. Only treat it as a question when the input shape is there.
  let pq = pending_question
  let has_question = pq != nil and pq["input"] != nil and pq["input"]["questions"] != nil
%>
<% if has_question %>
  <% let q = pq["input"]["questions"][0] %>
  <!-- No nested <form>: this partial is inserted inside the outer
       <form action="/.../tasks">. Each option button posts its own
       answer via hx-post + hx-vals. -->
  <div class="mb-4 rounded-xl bg-amber-400/10 border border-amber-400/30 p-4">
    <div class="text-xs text-amber-300/80 font-mono mb-1">human-in-the-loop · <%= pq["tool"] %></div>
    <div class="text-sm text-amber-100 mb-3"><%= h(q["question"]) %></div>
    <% for opt in q["options"] %>
      <% let vals = JSON.stringify({"qid": pq["id"], "value": opt["label"]}) %>
      <button type="button"
              hx-post="/projects/<%= project["name"] %>/tasks/plan-answer/<%= plan_id %>"
              hx-vals="<%= vals %>"
              hx-target="#plan-stream"
              hx-swap="outerHTML"
              class="block w-full text-left mb-1 px-3 py-2 rounded bg-amber-400/5 hover:bg-amber-400/15 text-sm text-amber-100 transition-colors">
        <span class="font-medium"><%= h(opt["label"]) %></span>
        <% if opt["description"] != nil and opt["description"] != "" %>
          <span class="text-amber-300/60 text-xs ml-2">— <%= h(opt["description"]) %></span>
        <% end %>
      </button>
    <% end %>
  </div>
<% end %>
