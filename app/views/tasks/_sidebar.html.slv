<% let body_for_render = strip_title_heading(task.body_md ?? "") %>
<div class="space-y-5 animate-fade-in">
  <header class="space-y-2">
    <p class="text-xs text-slate-500 font-mono"><%= task.project %> / <%= task.slug %></p>
    <h2 class="text-xl font-bold gradient-text"><%= task.title %></h2>
    <p class="text-xs text-slate-500">
      Status:
      <span class="inline-block rounded-md bg-indigo-500/20 text-indigo-300 px-2 py-0.5 text-xs font-medium ml-1"><%= task.status %></span>
    </p>
  </header>

  <div class="flex flex-wrap gap-2">
    <a href="/projects/<%= task.project %>/tasks/<%= task.slug %>"
       class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-3 py-1.5 transition-colors">
      View full page
    </a>
    <% if task.status == "todo" %>
      <form method="post" action="/projects/<%= task.project %>/tasks/<%= task.slug %>/queue">
        <button type="submit"
                class="rounded-lg bg-emerald-500/90 hover:bg-emerald-400 text-white text-sm font-medium px-3 py-1.5 transition-colors">
          Queue &rarr; agent
        </button>
      </form>
    <% end %>
  </div>

  <article class="task-md text-sm">
    <%- Markdown.to_safe_html(body_for_render) %>
  </article>
</div>
