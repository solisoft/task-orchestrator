<% let failed = status.starts_with("failed") %>
<%
  let pq = pending_question
  let has_question = pq != nil and pq["input"] != nil and pq["input"]["questions"] != nil
%>
<%
  # Streaming runs over a WebSocket; we open it only when the agent is
  # still alive AND there's no pending question. The same pause-around-
  # awaiting_question rule from the polling era survives the rewrite —
  # a tick that races a user's click could re-render the card and make
  # the click feel like it did nothing.
  let streaming = (status != "done" and not failed and not has_question)
  let initial_offset = (log ?? "").length
%>

<!-- Right panel: log + question card + status. The WS streamer
     appends new bytes into #plan-log, swaps #plan-status / #plan-question
     when they change, and (on terminal status) reloads the page so the
     controller can render the planned_body view in place of #form-stage. -->
<section id="plan-stream"
  <% if streaming %>
    data-stream-url="/ws/plan-stream"
    data-stream-project="<%= project["name"] %>"
    data-stream-plan-id="<%= plan_id %>"
    data-stream-log="#plan-log"
    data-stream-status="#plan-status"
    data-stream-question="#plan-question"
    data-stream-offset="<%= initial_offset %>"
    data-stream-tick-ms="300"
  <% end %>
>
  <input type="hidden" name="body_md" value="">

  <div id="plan-question">
    <%- render_partial("tasks/plan_question", {
      "project":          project,
      "plan_id":          plan_id,
      "pending_question": pq
    }) %>
  </div>

  <div class="rounded-xl neon-terminal overflow-hidden">
    <div id="plan-status" class="flex items-center gap-3 px-4 py-2 border-b border-white/5 text-xs font-mono">
      <%- render_partial("tasks/plan_status", {
        "plan_id":          plan_id,
        "status":           status,
        "pending_question": pq
      }) %>
    </div>
    <div id="plan-log" class="max-h-[70vh] overflow-y-auto" data-tail="bottom">
      <pre class="font-mono text-xs leading-relaxed p-4 whitespace-pre-wrap m-0"><% if log == "" %><span class="text-slate-600 italic">starting agent...</span><% else %><% for line in log.split("\n") %><span class="block <%= task_log_line_class(line) %>"><%= line %></span><% end %><% end %></pre>
    </div>
  </div>

  <div class="mt-4 flex justify-end gap-2">
    <a href="/projects/<%= project["name"] %>"
       class="rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium px-4 py-2 transition-colors">Cancel</a>
    <% if failed %>
      <button type="button"
              hx-post="/projects/<%= project["name"] %>/tasks/plan-retry/<%= plan_id %>"
              hx-target="#form-stage"
              hx-swap="innerHTML"
              class="rounded-lg bg-amber-500/80 hover:bg-amber-400 text-white text-sm font-medium px-4 py-2 transition-colors">
        Try again
      </button>
    <% end %>
  </div>
</section>

<script>
(function () {
  var box = document.getElementById('plan-log');
  if (!box) return;
  box.scrollTop = box.scrollHeight;
})();
</script>
