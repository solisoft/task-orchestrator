<% let polling = (status != "done" and not status.starts_with("failed")) %>
<% let failed  = status.starts_with("failed") %>
<%
  # `pending_question` carries either the question (with `input.questions`)
  # or the user's submitted answer (just `id` + `value`) until the agent
  # consumes it. Only treat it as a question when the input shape is there.
  let pq = pending_question
  let has_question = pq != nil and pq["input"] != nil and pq["input"]["questions"] != nil
%>

<!-- Right panel: log + question card + status. The polling element
     swaps itself (outerHTML on #plan-stream), so the left prompt
     aside is never re-rendered and never flashes. When the plan
     finishes, the controller responds with HX-Retarget: #form-stage
     so the whole stage transitions cleanly to the planned-body view. -->
<section id="plan-stream"
  <% if polling %>
    hx-get="/projects/<%= project["name"] %>/tasks/plan-log/<%= plan_id %>"
    hx-trigger="every 2s"
    hx-target="#plan-stream"
    hx-swap="outerHTML"
  <% end %>
>
  <input type="hidden" name="body_md" value="">

  <% if has_question %>
    <% let q = pq["input"]["questions"][0] %>
    <!-- No nested <form>: this partial is inserted inside the outer
         <form action="/.../tasks">. Each option button posts its own
         answer via hx-post + hx-vals. -->
    <div class="mb-4 rounded-xl bg-amber-400/10 border border-amber-400/30 p-4">
      <div class="text-xs text-amber-300/80 font-mono mb-1">human-in-the-loop · <%= pq["tool"] %></div>
      <div class="text-sm text-amber-100 mb-3"><%= h(q["question"]) %></div>
      <% for opt in q["options"] %>
        <% let vals = JSON.stringify({"qid": pq["id"], "value": opt["label"]}) %>
        <button type="button"
                hx-post="/projects/<%= project["name"] %>/tasks/plan-answer/<%= plan_id %>"
                hx-vals="<%= vals %>"
                hx-target="#plan-stream"
                hx-swap="outerHTML"
                class="block w-full text-left mb-1 px-3 py-2 rounded bg-amber-400/5 hover:bg-amber-400/15 text-sm text-amber-100 transition-colors">
          <span class="font-medium"><%= h(opt["label"]) %></span>
          <% if opt["description"] != nil and opt["description"] != "" %>
            <span class="text-amber-300/60 text-xs ml-2">— <%= h(opt["description"]) %></span>
          <% end %>
        </button>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-xl neon-terminal overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-2 border-b border-white/5 text-xs font-mono">
      <% if failed %>
        <span class="inline-flex items-center gap-2 rounded-full border bg-red-500/15 text-red-300 border-red-500/30 px-2 py-0.5">x <%= status %></span>
      <% elsif has_question %>
        <span class="inline-flex items-center gap-2 rounded-full border bg-amber-400/15 text-amber-300 border-amber-400/30 px-2 py-0.5">awaiting answer</span>
      <% else %>
        <span class="inline-flex items-center gap-2 rounded-full border bg-amber-400/15 text-amber-300 border-amber-400/30 px-2 py-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <%= status %>
        </span>
      <% end %>
      <span class="text-slate-500">plan-task · <%= plan_id %></span>
    </div>
    <div id="plan-log" class="max-h-[70vh] overflow-y-auto" data-tail="bottom">
      <pre class="font-mono text-xs leading-relaxed p-4 whitespace-pre-wrap m-0"><% if log == "" %><span class="text-slate-600 italic">starting agent...</span><% else %><% for line in log.split("\n") %><span class="block <%= task_log_line_class(line) %>"><%= line %></span><% end %><% end %></pre>
    </div>
  </div>

  <div class="mt-4 flex justify-end gap-2">
    <a href="/projects/<%= project["name"] %>"
       class="rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium px-4 py-2 transition-colors">Cancel</a>
    <% if failed %>
      <button type="button"
              hx-post="/projects/<%= project["name"] %>/tasks/plan-retry/<%= plan_id %>"
              hx-target="#form-stage"
              hx-swap="innerHTML"
              class="rounded-lg bg-amber-500/80 hover:bg-amber-400 text-white text-sm font-medium px-4 py-2 transition-colors">
        Try again
      </button>
    <% end %>
  </div>
</section>

<script>
(function () {
  var box = document.getElementById('plan-log');
  if (!box) return;
  box.scrollTop = box.scrollHeight;
  if (!document.body.dataset.planTailListener) {
    document.body.dataset.planTailListener = '1';
    document.body.addEventListener('htmx:afterSwap', function () {
      var b = document.getElementById('plan-log');
      if (b) b.scrollTop = b.scrollHeight;
    });
  }
})();
</script>
