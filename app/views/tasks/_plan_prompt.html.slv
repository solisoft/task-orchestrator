<!-- Left panel: prompt recap (read-only while running). Static across
     polls — the right `_plan_stream` partial is the only thing that
     re-renders, so this aside keeps its DOM identity (focus, scroll). -->
<aside class="space-y-4 animate-fade-in">
  <label class="block text-sm font-medium text-slate-300">Your prompt</label>
  <div class="rounded-xl glass-card p-4 text-sm text-slate-300 font-mono whitespace-pre-wrap min-h-[8rem]"><%= prompt == "" ? "(in-flight; see right pane)" : prompt %></div>
  <p class="text-xs text-slate-500 italic">The agent is planning. Refining is available once the draft is ready.</p>
</aside>
