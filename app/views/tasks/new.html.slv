<div class="min-h-screen text-white">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <%- partial("shared/breadcrumbs", { "crumbs": [
      { "label": "Projects",      "href": "/projects" },
      { "label": project["name"], "href": "/projects/" + project["name"] },
      { "label": "New task",      "href": "" }
    ] }) %>

    <h1 class="text-2xl font-bold mb-2 animate-fade-in">New task in <span class="gradient-text"><%= project["name"] %></span></h1>
    <p class="text-sm text-slate-500 mb-6 animate-fade-in">
      For larger ideas, write a
      <a href="/features/new?project=<%= project["name"] %>" class="text-indigo-300 hover:text-indigo-200 underline underline-offset-2">feature brief</a>
      and let the planner break it down. This form creates a single stand-alone task.
    </p>

    <% if task != nil and task._errors %>
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 text-red-200 text-sm px-4 py-3 mb-4">
        <% for field, errs in task._errors %>
          <div><strong><%= field %>:</strong> <%= errs.join(", ") %></div>
        <% end %>
      </div>
    <% end %>

    <form method="post" action="/projects/<%= project["name"] %>/tasks" class="space-y-4 rounded-xl glass-card p-6">
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1">Title</label>
        <input type="text" name="title" required value="<%= task == nil ? "" : (task.title ?? "") %>"
               class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-4 py-2 text-sm text-slate-100"
               placeholder="e.g. Bump pino-pretty to 11.x">
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1">Body (Markdown)</label>
        <textarea name="body_md" required rows="14"
                  placeholder="Acceptance criteria, links, file pointers — anything the agent needs to ship this."
                  class="w-full rounded-xl bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none p-4 font-mono text-sm text-slate-100 resize-y"><%= task == nil ? "" : (task.body_md ?? "") %></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1">Run with</label>
        <p class="text-xs text-slate-500 mb-2">Model used when this task is queued. Leave the default unless you have a reason.</p>
        <%- partial("features/plan_model_select", {
          "name":             "plan_model",
          "current":          default_plan_model,
          "claude_options":   claude_options,
          "opencode_options": opencode_options,
          "include_blank":    false,
          "blank_label":      ""
        }) %>
      </div>

      <div class="flex justify-end gap-2 pt-2">
        <a href="/projects/<%= project["name"] %>"
           class="rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium px-4 py-2 transition-colors">Cancel</a>
        <button type="submit"
                class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">
          Create task
        </button>
      </div>
    </form>
  </div>
</div>
