<div class="min-h-screen bg-slate-950 text-white">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <nav class="text-sm text-slate-500 mb-4">
      <a href="/" class="hover:text-slate-300">All projects</a>
      <span class="mx-2">/</span>
      <a href="/projects/<%= project["name"] %>" class="hover:text-slate-300"><%= project["name"] %></a>
      <span class="mx-2">/</span>
      <span class="text-slate-300">new task</span>
    </nav>

    <h1 class="text-2xl font-bold mb-6">New task in <span class="text-indigo-400"><%= project["name"] %></span></h1>

    <% if task != nil and task._errors %>
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 text-red-200 text-sm px-4 py-3 mb-4">
        <% for field, errs in task._errors %>
          <div><strong><%= field %>:</strong> <%= errs.join(", ") %></div>
        <% end %>
      </div>
    <% end %>

    <form method="post" action="/projects/<%= project["name"] %>/tasks">
      <div class="flex items-baseline justify-between mb-1">
        <label class="block text-sm font-medium text-slate-300">Title</label>
        <button type="button"
                hx-post="/projects/<%= project["name"] %>/tasks/plan"
                hx-include="textarea[name=body_md], [name=review_model]"
                hx-target="#body-md-wrapper"
                hx-swap="outerHTML"
                hx-indicator="#plan-spinner"
                class="text-xs text-indigo-300 hover:text-indigo-200 hover:bg-indigo-400/10 rounded px-2 py-1 transition-colors">
          ✨ Plan with agent
          <span id="plan-spinner" class="htmx-indicator ml-1">⏳</span>
        </button>
      </div>
      <div id="title-wrapper" class="mb-4">
        <input name="title" placeholder="A short, descriptive title (auto-filled by /plan-task)" value="<%= task == nil ? "" : (task.title ?? "") %>" class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-4 py-2 text-sm text-slate-100">
      </div>

      <label class="block text-sm font-medium text-slate-300 mb-1">Body (Markdown)</label>
      <div id="body-md-wrapper">
        <textarea name="body_md" required class="w-full h-[50vh] rounded-xl bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none p-4 font-mono text-sm text-slate-100 resize-y" placeholder="A few rough lines is fine — click ‘Plan with agent’ to expand into a structured spec."><%= task == nil ? "" : (task.body_md ?? "") %></textarea>
      </div>

      <div id="review-model-wrapper" class="mt-4">
        <label for="review_model" class="block text-sm font-medium text-slate-300 mb-1">Review model <span class="text-xs text-slate-500">(optional — falls back to the implementation model)</span></label>
        <input id="review_model" name="review_model" placeholder="e.g. claude-sonnet-4-20250514" value="<%= task == nil ? "" : (task.review_model ?? "") %>" class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-4 py-2 text-sm text-slate-100">
      </div>

      <div class="mt-3 flex justify-end gap-2">
        <a href="/projects/<%= project["name"] %>" class="rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium px-4 py-2 transition-colors">Cancel</a>
        <button type="submit" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors">Create</button>
      </div>
    </form>
  </div>
</div>
