<!-- Two-column in-flight view: static prompt aside on the left,
     polling log/status panel on the right. Split into two partials
     so the htmx poll only re-renders the right side. -->
<%- render_partial("tasks/plan_prompt", { "prompt": prompt }) %>
<%- render_partial("tasks/plan_stream", {
  "project":          project,
  "plan_id":          plan_id,
  "log":              log,
  "status":           status,
  "pending_question": pending_question
}) %>
