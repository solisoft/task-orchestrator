<% let body_for_render = strip_title_heading(task.body_md ?? "") %>
<div class="min-h-screen text-white">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <nav class="text-sm text-slate-500 mb-4 animate-fade-in">
      <a href="/" class="hover:text-slate-300 transition-colors">All projects</a>
      <span class="mx-2">/</span>
      <a href="/projects/<%= project["name"] %>" class="hover:text-slate-300"><%= project["name"] %></a>
      <span class="mx-2">/</span>
      <span class="text-slate-300"><%= task.slug %></span>
    </nav>

    <% if flash_error != nil %>
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 text-red-200 text-sm px-4 py-3 mb-4 flex items-start gap-2">
        <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div><%= flash_error %></div>
      </div>
    <% end %>

    <header class="mb-6 flex items-baseline justify-between flex-wrap gap-3 animate-fade-in">
      <div>
        <h1 class="text-2xl font-bold gradient-text"><%= task.title %></h1>
        <p class="text-xs text-slate-500 mt-1 font-mono"><%= task.slug %></p>
        <p class="text-xs text-slate-500 mt-1 flex items-center flex-wrap gap-2">
          <span>
            Status:
            <span class="inline-block rounded-md bg-indigo-500/20 text-indigo-300 px-2 py-0.5 text-xs font-medium ml-1"><%= task.status %></span>
            <% let _agent = (task.agent_type ?? "").trim() %>
            <% if _agent != "" %>
              <span>Agent: <span class="text-slate-400"><%= _agent %></span></span>
            <% end %>
            <% if task.tags != nil %>
              <% for tag in task.tags %>
                <% if tag == "follow_up" %>
                  <span class="inline-block rounded-md bg-amber-500/20 text-amber-300 px-2 py-0.5 text-xs font-medium ml-1">Follow-up</span>
                <% end %>
              <% end %>
            <% end %>
          </span>
          <% let _author = (task.author ?? "").trim() %>
          <% if _author != "" %>
            <span>by <span class="text-slate-400"><%= _author %></span></span>
          <% end %>
          <% if task.feature_slug != nil and task.feature_slug != "" %>
            <% let _feature = Feature.find_by("_key", task.feature_slug) %>
            <% let _feature_label = (_feature != nil and _feature.title != nil and _feature.title != "") ? _feature.title : task.feature_slug %>
            <a href="/features/<%= task.feature_slug %>" class="inline-flex items-center gap-1 rounded-full bg-sky-500/15 hover:bg-sky-500/25 text-sky-300 hover:text-sky-200 border border-sky-400/30 px-2.5 py-0.5 text-xs font-medium transition-colors">
              Feature: <%= _feature_label %>
            </a>
          <% end %>
          <% if task.pr_url != nil and task.pr_url != "" %>
            <a href="<%= task.pr_url %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-300 hover:text-indigo-200 border border-indigo-400/30 px-2.5 py-0.5 text-xs font-medium transition-colors">
              Open PR
              <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor"><path d="M3 3v10h10V8h1v6H2V2h6v1H3zm6.5 0h3.5v3.5h-1V4.7L8.4 9.3l-.7-.7L12.3 4H9.5V3z"/></svg>
            </a>
          <% end %>
        </p>
      </div>
      <div class="flex gap-2">
        <a href="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/run" class="rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors">View run log</a>
        <% if task.status == "todo" %>
          <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/queue" class="flex items-center gap-2">
            <span class="w-44 shrink-0">
              <%- partial("features/plan_model_select", {
                "name":             "plan_model",
                "current":          (task.model ?? "") == "" ? default_plan_model : task.model,
                "claude_options":   claude_options,
                "opencode_options": opencode_options,
                "codex_options":    codex_options,
                "include_blank":    false,
                "blank_label":      ""
              }) %>
            </span>
            <select name="plan_variant"
                    title="Reasoning effort. Applies to opencode reasoning models only — claude ignores it."
                    class="rounded-md bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-2 py-1 text-xs text-slate-200">
              <option value="default" selected>Default</option>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
            <button type="submit" class="rounded-lg bg-emerald-500/90 hover:bg-emerald-400 text-white text-sm font-medium px-4 py-2 transition-colors">Queue &rarr; agent</button>
          </form>
          <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/archive" data-confirm="Archive this todo task?">
            <button type="submit" class="rounded-lg bg-slate-600/90 hover:bg-slate-500 text-white text-sm font-medium px-4 py-2 transition-colors">Archive</button>
          </form>
        <% end %>
        <% if task.status == "review" %>
          <% if can_commit_push %>
            <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/commit-push" data-confirm="Commit and push all local changes in the worktree to the PR branch?">
              <button type="submit" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors">Commit &amp; push fixes &rarr; PR</button>
            </form>
          <% end %>
          <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/mark-done" data-confirm="Mark this task as done?">
            <button type="submit" class="rounded-lg bg-emerald-500/90 hover:bg-emerald-400 text-white text-sm font-medium px-4 py-2 transition-colors">Mark as done</button>
          </form>
          <% if task.pr_url != nil and task.pr_url != "" %>
            <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/mark-done">
              <input type="hidden" name="force" value="true">
              <button type="submit" class="rounded-lg bg-amber-500/90 hover:bg-amber-400 text-slate-900 text-sm font-medium px-4 py-2 transition-colors">Force mark as done</button>
            </form>
          <% end %>
        <% end %>
        <% if task.status == "queued" %>
          <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/unqueue">
            <button type="submit" class="rounded-lg bg-amber-500/90 hover:bg-amber-400 text-slate-900 text-sm font-medium px-4 py-2 transition-colors">Cancel &larr; back to todo</button>
          </form>
        <% end %>
        <% if task.status == "done" or task.status == "failed" %>
          <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/archive">
            <button type="submit" class="rounded-lg bg-slate-600/90 hover:bg-slate-500 text-white text-sm font-medium px-4 py-2 transition-colors">Archive</button>
          </form>
        <% end %>
        <% if task.status == "archived" %>
          <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/unarchive">
            <button type="submit" class="rounded-lg bg-emerald-500/90 hover:bg-emerald-400 text-white text-sm font-medium px-4 py-2 transition-colors">Restore to todo</button>
          </form>
        <% end %>
      </div>
    </header>

    <% if task.status == "review" and task.pr_url != nil and task.pr_url != "" %>
      <div class="mb-6 rounded-xl glass-card p-4 animate-fade-in animate-fade-in-1">
        <details open>
          <summary class="text-sm font-semibold text-indigo-300 cursor-pointer select-none">React to PR — send feedback to agent</summary>
          <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/react" class="mt-3">
            <textarea name="prompt" rows="4" placeholder="e.g. fix the null check in handle_response, add unit test for edge case, update the docs…" class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none p-3 font-mono text-sm text-slate-100 resize-y" required></textarea>
            <div class="mt-2 flex items-center justify-between text-xs text-slate-500">
              <span>The agent will implement changes in the worktree (no commit). Use &ldquo;Commit &amp; push fixes &rarr; PR&rdquo; after review.</span>
              <button type="submit" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors">React</button>
            </div>
          </form>
        </details>
      </div>
    <% end %>

    <% if task.status == "review" %>
      <%- partial("tasks/code_review", {
        "project":              project,
        "task":                 task,
        "default_plan_model":   default_plan_model,
        "default_review_model": default_review_model,
        "claude_options":       claude_options,
        "opencode_options":     opencode_options,
        "codex_options":        codex_options,
        "reviews":              code_reviews
      }) %>
    <% end %>

    <% if branch_info != nil %>
      <div class="mb-6 rounded-xl glass-card p-4 animate-fade-in animate-fade-in-1">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center gap-2 text-sm flex-wrap">
            <span class="text-slate-400">Branch</span>
            <code class="font-mono text-indigo-300"><%= branch_info["name"] %></code>
            <% if not branch_info["exists"] %>
              <span class="inline-flex items-center gap-1 rounded-full border border-slate-600/40 bg-slate-700/40 text-slate-400 px-2 py-0.5 text-xs">
                missing locally
              </span>
            <% elsif branch_info["merged"] %>
              <span class="inline-flex items-center gap-1 rounded-full border border-emerald-400/30 bg-emerald-400/15 text-emerald-300 px-2 py-0.5 text-xs">
                merged into <%= branch_info["main"] %>
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 rounded-full border border-amber-400/30 bg-amber-400/15 text-amber-300 px-2 py-0.5 text-xs">
                not merged into <%= branch_info["main"] %>
              </span>
            <% end %>
          </div>
          <% if branch_info["exists"] and not branch_info["merged"] %>
            <% if branch_info["is_local_branch"] and task.status == "review" %>
              <form method="post"
                    action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/merge"
                    data-confirm="Merge '<%= branch_info["name"] %>' into <%= branch_info["main"] %>? Runs git merge --no-ff in <%= project["path"] %>.">
                <button type="submit" class="rounded-lg bg-emerald-500/90 hover:bg-emerald-400 text-white text-sm font-medium px-4 py-2 transition-colors">
                  Merge into <%= branch_info["main"] %>
                </button>
              </form>
            <% end %>
            <% if branch_info["worktree_path"] == nil %>
              <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/checkout">
                <button type="submit" class="rounded-lg bg-amber-500/90 hover:bg-amber-400 text-slate-900 text-sm font-medium px-4 py-2 transition-colors">
                  Checkout for testing
                </button>
              </form>
            <% end %>
          <% end %>
        </div>
        <% if branch_info["worktree_path"] != nil %>
          <div class="mt-3 flex items-center gap-2 flex-wrap">
            <span class="text-xs text-slate-400 shrink-0">Worktree</span>
            <code id="worktree-path" class="font-mono text-xs text-indigo-300 bg-slate-900/60 border border-white/5 rounded px-2 py-1 break-all flex-1 min-w-0"><%= branch_info["worktree_path"] %></code>
            <button type="button"
                    onclick="navigator.clipboard.writeText(document.getElementById('worktree-path').textContent); this.textContent='Copied'; setTimeout(() => this.textContent='Copy', 1500);"
                    class="shrink-0 rounded-md bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-xs font-medium px-2.5 py-1 transition-colors">
              Copy
            </button>
          </div>
          <p class="text-xs text-slate-500 mt-2">
            Branch is checked out in this worktree — <code class="font-mono">cd</code> in to inspect; can't be checked out in <code class="font-mono"><%= project["path"] %></code> while the worktree is active.
          </p>
        <% elsif branch_info["exists"] and not branch_info["merged"] %>
          <p class="text-xs text-slate-500 mt-2">
            Requires <code class="font-mono"><%= branch_info["main"] %></code> checked out and a clean working tree in <code class="font-mono"><%= project["path"] %></code>.
          </p>
        <% end %>
      </div>
    <% end %>

    <% if task.status == "todo" %>
      <!-- Editable body: rendered view by default; click "Edit" to switch to the textarea form. -->
      <div id="task-body">
        <div id="task-body-view" class="rounded-xl glass-card p-6">
          <div class="flex items-center justify-end mb-3 -mt-2 -mr-2">
            <button type="button"
                    onclick="document.getElementById('task-body-view').classList.add('hidden'); document.getElementById('task-body-edit').classList.remove('hidden'); document.querySelector('#task-body-edit textarea').focus();"
                    class="text-xs text-slate-400 hover:text-indigo-300 hover:bg-indigo-400/10 rounded px-2 py-1 transition-colors">
              ✎ Edit
            </button>
          </div>
          <article class="task-md text-sm">
            <%- Markdown.to_safe_html(body_for_render) %>
          </article>
        </div>

        <form id="task-body-edit" class="hidden" method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/save">
          <label class="block text-sm font-medium text-slate-300 mb-1">Title</label>
          <input name="title" value="<%= task.title %>" class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-4 py-2 text-sm text-slate-100 mb-4">
          <label class="block text-sm font-medium text-slate-300 mb-1">Body (Markdown)</label>
          <textarea name="body_md" class="w-full h-[55vh] rounded-xl bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none p-4 font-mono text-sm text-slate-100 resize-y"><%= task.body_md %></textarea>
          <div class="mt-4 grid grid-cols-[5rem_1fr] items-center gap-x-3 gap-y-2 text-xs text-slate-400">
            <label for="plan_model" class="text-right">Run with</label>
            <%- partial("features/plan_model_select", {
              "name":             "plan_model",
              "current":          (task.model ?? "") == "" ? default_plan_model : task.model,
              "claude_options":   claude_options,
              "opencode_options": opencode_options,
              "codex_options":    codex_options,
              "include_blank":    false,
              "blank_label":      ""
            }) %>
            <label for="task-edit-plan-variant" class="text-right">Effort</label>
            <div class="flex items-center gap-2">
              <select id="task-edit-plan-variant" name="plan_variant"
                      title="Reasoning effort. Applies to opencode reasoning models only — claude ignores it."
                      class="rounded-md bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-2 py-1 text-xs text-slate-200">
                <option value="default" selected>Default</option>
                <option value="low">Low</option>
                <option value="medium">Medium</option>
                <option value="high">High</option>
              </select>
              <span class="text-[11px] text-slate-500 italic">opencode only</span>
            </div>
          </div>
          <div class="mt-3 flex justify-end gap-2">
            <button type="button"
                    onclick="document.getElementById('task-body-edit').classList.add('hidden'); document.getElementById('task-body-view').classList.remove('hidden');"
                    class="rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium px-4 py-2 transition-colors">Cancel</button>
            <button type="submit" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors">Save</button>
          </div>
        </form>
      </div>
    <% else %>
      <!-- Read-only rendered markdown for non-todo tasks. -->
      <div class="rounded-xl glass-card p-6">
        <p class="text-xs text-slate-500 mb-3 italic">Read-only — task has left the todo column. Click "Cancel" above to move back if you need to edit.</p>
        <article class="task-md text-sm">
          <%- Markdown.to_safe_html(body_for_render) %>
        </article>
      </div>
    <% end %>
  </div>
</div>
