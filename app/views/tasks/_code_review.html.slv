<%
  # Code-review panel rendered inside the `if task.status == "review"`
  # block on the task show page. Lets the user spawn `/review-task` in
  # the existing worktree under a chosen agent model — the transcript
  # streams to the same run log as `/do-task`.
  #
  # Locals:
  #   - project, task                     — current row context
  #   - default_plan_model                — fallback when task.model is unset
  #   - claude_options / opencode_options — already filtered by the
  #                                         user's allowlist
%>
<div class="mb-6 rounded-xl glass-card p-4 animate-fade-in animate-fade-in-1">
  <details>
    <summary class="text-sm font-semibold text-indigo-300 cursor-pointer select-none">Run code review — review the PR with an agent</summary>
    <form method="post" action="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/code-review" class="mt-3">
      <div class="grid grid-cols-[5rem_1fr] items-center gap-x-3 gap-y-2 text-xs text-slate-400 mb-3">
        <label for="plan_model" class="text-right">Model</label>
        <%- partial("features/plan_model_select", {
          "name":             "plan_model",
          "current":          (task.model ?? "") == "" ? default_plan_model : task.model,
          "claude_options":   claude_options,
          "opencode_options": opencode_options,
          "include_blank":    false,
          "blank_label":      ""
        }) %>
        <label for="code-review-plan-variant" class="text-right">Effort</label>
        <div class="flex items-center gap-2">
          <select id="code-review-plan-variant" name="plan_variant"
                  title="Reasoning effort. Applies to opencode reasoning models only — claude ignores it."
                  class="rounded-md bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-2 py-1 text-xs text-slate-200">
            <option value="default" selected>Default</option>
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
          </select>
          <span class="text-[11px] text-slate-500 italic">opencode only</span>
        </div>
      </div>
      <div class="mt-2 flex items-center justify-between text-xs text-slate-500 gap-3">
        <span>Runs <code class="font-mono">/review-task</code> in the existing worktree and appends to the run log.</span>
        <button type="submit" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors">Run code review</button>
      </div>
    </form>
  </details>
</div>
