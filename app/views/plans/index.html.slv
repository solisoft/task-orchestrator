<div class="min-h-screen text-white">
  <div class="max-w-6xl mx-auto px-6 py-12">

    <header class="mb-10 animate-fade-in">
      <div class="flex items-baseline justify-between flex-wrap gap-3 mb-3">
        <h1 class="text-3xl font-bold tracking-tight hero-shimmer">Plans</h1>
        <a href="/" class="rounded-lg glass-card-light hover:bg-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">Home</a>
      </div>
      <p class="text-slate-400 text-sm max-w-2xl leading-relaxed">
        <%= plans.length %> plan<% if plans.length != 1 %>s<% end %> — agent-drafted task specs and stalled runs. Done plans with a body are ready to convert into tasks.
      </p>
    </header>

    <% if plans.length == 0 %>
      <div class="rounded-2xl border border-slate-500/20 bg-slate-900/30 p-8 text-center animate-fade-in">
        <p class="text-slate-400">No plans yet. Create one on a project's "New task" page.</p>
      </div>
    <% else %>
      <div class="space-y-4 animate-fade-in animate-fade-in-1">
        <% for plan in plans %>
          <details class="rounded-xl glass-card border border-white/10 group" <%= plan.status == "done" ? "open" : "" %>>
            <summary class="flex items-center gap-4 px-5 py-3 cursor-pointer hover:bg-white/[0.02] transition-colors rounded-xl select-none marker:hidden">
              <% if plan.status == "done" %>
                <span class="shrink-0 w-2 h-2 rounded-full bg-emerald-400 shadow-glow-emerald"></span>
              <% elsif plan.status.starts_with("failed") %>
                <span class="shrink-0 w-2 h-2 rounded-full bg-red-400 shadow-glow-red"></span>
              <% else %>
                <span class="shrink-0 w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <% end %>

              <span class="text-sm font-mono text-slate-300 shrink-0"><%= plan.plan_id %></span>

              <span class="text-xs font-mono uppercase px-2 py-0.5 rounded-full shrink-0
                <%= plan.status == "done" ? "bg-emerald-400/10 text-emerald-300 border border-emerald-400/20" : "" %>
                <%= plan.status.starts_with("failed") ? "bg-red-400/10 text-red-300 border border-red-400/20" : "" %>
                <%= plan.status != "done" and not plan.status.starts_with("failed") ? "bg-amber-400/10 text-amber-300 border border-amber-400/20" : "" %>
              "><%= plan.status %></span>

              <span class="text-xs text-slate-500 font-mono shrink-0"><%= plan.model %></span>

              <span class="text-xs text-slate-400 truncate flex-1 min-w-0"><%= plan.prompt_emoji %></span>

              <svg class="w-4 h-4 text-slate-500 shrink-0 transition-transform details-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>

            <% if plan.status == "done" and plan.body != "" and plan.body != nil %>
              <div class="border-t border-white/5 px-5 py-4">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400/70">Spec preview</span>
                  <span class="text-[11px] text-slate-500 italic">rendered from markdown</span>
                </div>
                <article class="task-md rounded-lg bg-slate-900/40 border border-white/5 p-4 text-sm max-h-[50vh] overflow-y-auto">
                  <%- Markdown.to_safe_html(plan.body) %>
                </article>
              </div>
            <% end %>

            <% if plan.body != "" and plan.body != nil %>
              <div class="border-t border-white/5 px-5 py-3 flex gap-2">
                <details class="w-full">
                  <summary class="text-xs text-slate-500 cursor-pointer hover:text-slate-300 transition-colors select-none marker:content-[''] inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                    Raw markdown source
                  </summary>
                  <pre class="mt-2 rounded-lg bg-slate-900/80 border border-white/5 p-4 font-mono text-xs text-slate-300 max-h-[30vh] overflow-y-auto whitespace-pre-wrap"><%= plan.body %></pre>
                </details>
              </div>
            <% end %>

            <% if plan.status == "done" and plan.body != "" and plan.body != nil and plan.prompt != "" and plan.prompt != nil %>
              <div class="border-t border-white/5 px-5 py-2 flex items-center gap-2">
                <span class="text-[11px] text-slate-500 italic">Original prompt:</span>
                <span class="text-xs text-slate-400 font-mono truncate"><%= plan.prompt_emoji %></span>
              </div>
            <% end %>
          </details>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<style>
  details[open] > summary .details-chevron { transform: rotate(180deg); }
  details > summary .details-chevron { transform: rotate(0deg); }
</style>