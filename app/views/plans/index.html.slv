<div class="min-h-screen text-white">
    <div class="max-w-6xl mx-auto px-6 py-12">
        <header class="mb-10 animate-fade-in">
            <div class="flex items-baseline justify-between flex-wrap gap-3 mb-6">
                <div>
                    <h1 class="text-4xl font-bold tracking-tight hero-shimmer">Plans</h1>
                    <p class="mt-2 text-slate-400 font-mono text-sm">Completed plan specs not yet converted to tasks</p>
                </div>
                <a href="/" class="rounded-lg glass-card-light hover:bg-white/10 text-slate-300 hover:text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">Home</a>
            </div>
        </header>

        <% if plans.length == 0 %>
            <div class="rounded-2xl border border-slate-600/30 bg-slate-800/30 p-8 text-center animate-fade-in">
                <p class="text-slate-400 font-medium">No unconverted plans found.</p>
                <p class="mt-2 text-slate-500 text-sm">Use the "Plan it" button on the new-task form to create one.</p>
            </div>
        <% end %>

        <div class="space-y-4">
            <% for p in plans %>
                <article class="rounded-2xl glass-card p-6 animate-fade-in">
                    <div class="flex items-baseline justify-between flex-wrap gap-3 mb-3">
                        <h2 class="text-lg font-semibold text-slate-100"><%= h(p["title"]) %></h2>
                        <span class="text-xs font-mono text-slate-500"><%= p["plan_id"] %></span>
                    </div>
                    <% if p["project_name"] != "" %>
                        <a href="/projects/<%= p["project_name"] %>/tasks/new?plan_id=<%= p["plan_id"] %>"
                           class="inline-block rounded-lg bg-indigo-600/80 hover:bg-indigo-500 text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">
                            Create task
                        </a>
                    <% else %>
                        <span class="text-xs text-slate-500">No project associated</span>
                    <% end %>
                </article>
            <% end %>
        </div>
    </div>
</div>
