<div id="board">
  <% let _limit_error = locals["limit_error"] ?? nil %>
  <% if _limit_error != nil %>
    <div class="mb-3 rounded-md border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-200">
      ⛔ <%= _limit_error %>
    </div>
  <% end %>
  <!-- tab strip -->
  <nav class="flex items-center gap-1 border-b border-white/10 mb-4 overflow-x-auto">
    <% for status in statuses %>
      <% let count = columns[status].length %>
      <% let is_active = status == active_tab %>
      <a href="/projects/<%= project["name"] %>?tab=<%= status %>"
         class="<%= is_active ? "border-indigo-400 text-white" : "border-transparent text-slate-400 hover:text-slate-200 hover:border-slate-600" %> inline-flex items-center gap-2 border-b-2 px-4 py-2.5 text-sm font-medium whitespace-nowrap transition-colors -mb-px">
        <%= status %>
        <span class="<%= is_active ? "bg-indigo-500/20 text-indigo-200" : "bg-white/5 text-slate-500" %> rounded-full px-2 py-0.5 text-xs font-mono">
          <%= count %>
        </span>
      </a>
    <% end %>
  </nav>

  <!-- active list -->
  <section class="rounded-xl bg-white/5 border border-white/10 overflow-hidden">
    <ul class="divide-y divide-white/5">
      <% for task in columns[active_tab] %>
        <li class="group flex items-center gap-3 pl-4 pr-2 py-3 hover:bg-white/5 transition-colors">
          <% if indicators[task.slug] == "running" %>
            <span title="agent running" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse flex-shrink-0"></span>
          <% elsif indicators[task.slug] == "done" %>
            <span title="PR opened" class="w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0"></span>
          <% elsif indicators[task.slug] == "failed" %>
            <span title="last run failed" class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0"></span>
          <% else %>
            <span class="w-2 h-2 rounded-full bg-slate-700 flex-shrink-0"></span>
          <% end %>
          <a href="/projects/<%= project["name"] %>/tasks/<%= task.slug %>" class="flex-1 min-w-0">
            <div class="text-sm text-slate-100 leading-snug"><%= task.title %></div>
            <div class="text-xs font-mono text-slate-500 mt-0.5 truncate"><%= task.slug %></div>
          </a>
          <% if indicators[task.slug] != nil %>
            <a href="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/run" title="View run log" class="px-2 py-1 text-sm text-slate-400 hover:text-indigo-300 hover:bg-indigo-400/15 rounded opacity-0 group-hover:opacity-100 transition-opacity">📜</a>
          <% end %>
          <% if active_tab == "todo" %>
            <button title="Queue → fires agent" hx-post="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/queue" hx-target="#board" hx-swap="outerHTML" class="px-3 py-1 text-sm text-emerald-400 hover:bg-emerald-400/15 rounded opacity-0 group-hover:opacity-100 transition-opacity" type="button">▶ Queue</button>
          <% end %>
          <% if active_tab == "queued" or active_tab == "review" %>
            <button title="Move back to todo" hx-post="/projects/<%= project["name"] %>/tasks/<%= task.slug %>/unqueue" hx-target="#board" hx-swap="outerHTML" class="px-3 py-1 text-sm text-amber-400 hover:bg-amber-400/15 rounded opacity-0 group-hover:opacity-100 transition-opacity" type="button">↩ Cancel</button>
          <% end %>
        </li>
      <% end %>
      <% if columns[active_tab].length == 0 %>
        <li class="text-center text-slate-600 text-xs py-12 italic">no tasks in <%= active_tab %></li>
      <% end %>
    </ul>
  </section>
</div>
