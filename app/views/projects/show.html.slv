<div class="min-h-screen bg-slate-950 text-white">
    <div class="max-w-4xl mx-auto px-6 py-10">
        <header class="mb-8 flex items-baseline justify-between gap-4 flex-wrap">
            <div>
                <a href="/" class="text-slate-500 hover:text-slate-300 text-sm">&larr; All projects</a>
                <h1 class="text-3xl font-bold tracking-tight mt-1"><%= project["name"] %></h1>
                <p class="text-xs text-slate-500 font-mono mt-1"><%= project["path"] %></p>
            </div>
            <a href="/projects/<%= project["name"] %>/tasks/new" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors">+ New task</a>
        </header>

        <%- render_partial("projects/board", {
            "project": project,
            "columns": columns,
            "indicators": indicators,
            "statuses": statuses,
            "active_tab": active_tab
        }) %>
    </div>
</div>
