<div class="min-h-screen text-white">
  <div class="max-w-5xl mx-auto px-6 py-10">

    <header class="mb-8 flex items-baseline justify-between gap-4 flex-wrap animate-fade-in">
      <div>
        <%- partial("shared/breadcrumbs", { "crumbs": [
          { "label": "Projects", "href": "/projects" },
          { "label": project["name"], "href": "" }
        ] }) %>
        <h1 class="text-3xl font-bold tracking-tight gradient-text"><%= project["name"] %></h1>
        <p class="text-xs text-slate-500 font-mono mt-1"><%= project["path"] %></p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/projects/<%= project["name"] %>/versions/new" class="rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium px-4 py-2 transition-colors">+ New cycle</a>
        <a href="/features/new?project=<%= project["name"] %>" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">+ New feature</a>
      </div>
    </header>

    <!-- hub tab strip: Shape → Bet → Build → Ship → Cycles -->
    <nav class="flex items-center gap-1 border-b border-white/10 mb-6 animate-fade-in overflow-x-auto">
      <% _hub_tabs = [
        { "key": "shape",  "label": "Shape",  "count": (features_by_stage["shape"]  ?? []).length() },
        { "key": "bet",    "label": "Bet",    "count": (features_by_stage["bet"]    ?? []).length() },
        { "key": "build",  "label": "Build",  "count": build_lanes.length() },
        { "key": "ship",   "label": "Ship",   "count": ship_rows.length() },
        { "key": "cycles", "label": "Cycles", "count": versions.length() }
      ] %>
      <% for tab in _hub_tabs %>
        <a href="/projects/<%= project["name"] %>?tab=<%= tab["key"] %>"
           class="<%= hub_tab == tab["key"] ? "tab-active text-white" : "text-slate-400 hover:text-slate-200" %> tab-animated inline-flex items-center px-5 py-2.5 text-sm font-medium whitespace-nowrap transition-colors">
          <%= tab["label"] %>
          <% if tab["count"] > 0 %>
            <span class="ml-2 text-[10px] font-mono <%= hub_tab == tab["key"] ? "text-indigo-200" : "text-slate-500" %>"><%= tab["count"] %></span>
          <% end %>
        </a>
      <% end %>
    </nav>

    <!-- Shape: drafts -->
    <% if hub_tab == "shape" %>
      <%- partial("projects/shape", {
          "project":           project,
          "features_by_stage": features_by_stage
      }) %>
    <% end %>

    <!-- Bet: ready features awaiting cycle / planning -->
    <% if hub_tab == "bet" %>
      <%- partial("projects/bet", {
          "project":           project,
          "features_by_stage": features_by_stage,
          "versions":          versions
      }) %>
    <% end %>

    <!-- Build: feature swimlanes (or flat board via ?view=flat) -->
    <% if hub_tab == "build" %>
      <%- partial("projects/build", {
          "project":     project,
          "build_view":  build_view,
          "build_lanes": build_lanes,
          "columns":     columns,
          "indicators":  indicators,
          "totals":      totals,
          "agents":      agents,
          "statuses":    statuses,
          "active_tab":  active_tab
      }) %>
    <% end %>

    <!-- Ship: features awaiting PR merge -->
    <% if hub_tab == "ship" %>
      <%- partial("projects/ship", {
          "project":   project,
          "ship_rows": ship_rows
      }) %>
    <% end %>

    <!-- Cycles: Shape Up roadmap (renamed) + burndown summary -->
    <% if hub_tab == "cycles" %>
      <%- partial("projects/cycles_summary", {
          "project":          project,
          "version_progress": version_progress
      }) %>
      <%- partial("projects/roadmap", {
          "project":              project,
          "versions":             versions,
          "features_by_version":  features_by_version,
          "unscheduled_features": unscheduled_features
      }) %>
    <% end %>

  </div>
</div>
