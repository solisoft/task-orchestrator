<div class="animate-fade-in">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-lg font-semibold text-slate-100 tracking-tight">Build</h2>
      <p class="text-xs text-slate-500 mt-0.5">In-flight work grouped by feature &middot; columns are task statuses</p>
    </div>
    <div class="flex items-center gap-2">
      <div class="inline-flex rounded-lg border border-white/10 overflow-hidden text-xs font-medium">
        <% _is_swim = build_view == "swimlanes" %>
        <a href="/projects/<%= h(project["name"]) %>?tab=build"
           class="<%= _is_swim ? "bg-indigo-500/30 text-white" : "bg-transparent text-slate-400 hover:text-slate-200" %> px-3 py-1.5 transition-colors">
          Swimlanes
        </a>
        <a href="/projects/<%= h(project["name"]) %>?tab=build&amp;view=flat"
           class="<%= _is_swim ? "bg-transparent text-slate-400 hover:text-slate-200" : "bg-indigo-500/30 text-white" %> px-3 py-1.5 transition-colors border-l border-white/10">
          Flat
        </a>
      </div>
      <a href="/projects/<%= h(project["name"]) %>/tasks/new"
         class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-500/20 hover:bg-indigo-500/30 border border-indigo-500/30 text-indigo-300 text-sm font-medium px-3 py-1.5 transition-all">
        + New task
      </a>
    </div>
  </div>

  <% if build_view == "flat" %>
    <%- partial("projects/board", {
        "project":    project,
        "columns":    columns,
        "indicators": indicators,
        "totals":     totals,
        "agents":     agents,
        "statuses":   statuses,
        "active_tab": active_tab
    }) %>
  <% else %>
    <% _build_statuses = ["todo", "queued", "inprogress", "review", "failed"] %>
    <% if build_lanes.length() == 0 %>
      <div class="rounded-2xl glass-card border border-white/5 px-8 py-14 text-center animate-fade-in-1">
        <p class="text-slate-300 font-medium mb-1">Nothing in flight</p>
        <p class="text-slate-500 text-sm">Generate tasks from a bet and queue one to start building.</p>
      </div>
    <% else %>
      <div class="space-y-3 animate-fade-in-1">
        <% for lane in build_lanes %>
          <% _f      = lane["feature"] %>
          <% _bystat = lane["by_status"] ?? {} %>
          <% _ls     = lane["stage"] ?? "build" %>

          <article class="rounded-2xl glass-card border <%= _ls == "ship" ? "border-emerald-500/20" : "border-white/5" %> overflow-hidden">
            <header class="flex items-center justify-between gap-3 px-5 py-3 border-b border-white/5">
              <div class="min-w-0 flex items-center gap-3">
                <% if _f != nil %>
                  <a href="/features/<%= h(_f._key) %>" class="text-sm font-semibold text-slate-100 hover:text-white truncate"><%= h(_f.title) %></a>
                  <%- partial("shared/feature_stage_dots", { "stage": _ls }) %>
                <% else %>
                  <span class="text-sm font-semibold text-slate-300">Standalone</span>
                  <span class="text-[10px] text-slate-500 uppercase tracking-wider">no feature</span>
                <% end %>
              </div>
            </header>

            <div class="grid gap-px bg-white/[0.04]" style="grid-template-columns: repeat(<%= _build_statuses.length() %>, minmax(0, 1fr))">
              <% for status in _build_statuses %>
                <% _col = _bystat[status] ?? [] %>
                <div class="bg-slate-900/40 p-3 min-h-[5rem]">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] uppercase tracking-wider text-slate-500"><%= status %></span>
                    <span class="text-[10px] font-mono text-slate-600"><%= _col.length() %></span>
                  </div>
                  <ul class="space-y-1.5">
                    <% for t in _col %>
                      <li>
                        <a href="/projects/<%= h(project["name"]) %>/tasks/<%= h(t.slug) %>"
                           class="block rounded-md bg-white/[0.03] hover:bg-white/[0.07] border border-white/5 px-2 py-1.5 transition-colors group">
                          <div class="text-xs text-slate-200 group-hover:text-white leading-snug truncate"><%= h(t.title) %></div>
                          <% if indicators[t.slug] != nil %>
                            <div class="flex items-center gap-1 mt-1">
                              <% if indicators[t.slug] == "running" %>
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                                <span class="text-[10px] text-amber-300/80">running</span>
                              <% elsif indicators[t.slug] == "done" %>
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                <span class="text-[10px] text-emerald-300/80">PR open</span>
                              <% elsif indicators[t.slug] == "failed" %>
                                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                <span class="text-[10px] text-red-300/80">failed</span>
                              <% end %>
                            </div>
                          <% end %>
                        </a>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  <% end %>

</div>
