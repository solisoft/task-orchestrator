<div class="min-h-screen text-white">
  <div class="max-w-5xl mx-auto px-6 py-10">

    <header class="mb-8 animate-fade-in">
      <nav class="text-sm text-slate-500 mb-3">
        <a href="/" class="hover:text-slate-300 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-slate-300">Projects</span>
      </nav>
      <h1 class="text-3xl font-bold tracking-tight gradient-text">Projects</h1>
      <p class="mt-2 text-slate-400 text-sm max-w-2xl leading-relaxed">
        Each project is a repo under your workspace root with a <code class="text-slate-300">tasks/</code> folder.
        Open one to reach its Shape Up hub — board, roadmap, and overview tabs.
      </p>
    </header>

    <% if projects.length() == 0 %>
      <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-8 text-center animate-fade-in">
        <p class="text-amber-300 font-medium">No projects found.</p>
        <p class="mt-2 text-slate-400 text-sm">Create a <code class="text-amber-300">tasks/</code> folder inside a repo under your workspace root.</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-fade-in animate-fade-in-1">
        <% for p in projects %>
          <% let _vc = version_counts[p["name"]] ?? { "total": 0, "active": 0 } %>
          <article class="glass-card rounded-xl p-5 hover:border-indigo-400/40 transition-colors group">
            <div class="flex items-start justify-between gap-3 mb-3">
              <a href="/projects/<%= h(p["name"]) %>" class="text-lg font-semibold tracking-tight text-white group-hover:text-indigo-200 transition-colors truncate">
                <%= h(p["name"]) %>
              </a>
              <span class="shrink-0 text-xs font-mono text-slate-500"><%= p["total"] %> tasks</span>
            </div>
            <p class="text-xs text-slate-500 font-mono truncate mb-4" title="<%= h(p["path"]) %>"><%= h(p["path"]) %></p>
            <div class="flex items-center gap-2 text-xs">
              <a href="/projects/<%= h(p["name"]) %>?tab=roadmap"
                 class="inline-flex items-center gap-1 rounded-md bg-fuchsia-500/10 hover:bg-fuchsia-500/20 text-fuchsia-200 px-2.5 py-1 transition-colors">
                Roadmap
                <% if _vc["total"] > 0 %>
                  <span class="font-mono text-fuchsia-300/80">
                    <%= _vc["total"] %><% if _vc["active"] > 0 %><span class="text-fuchsia-400">·<%= _vc["active"] %> active</span><% end %>
                  </span>
                <% end %>
              </a>
              <a href="/projects/<%= h(p["name"]) %>/versions"
                 class="inline-flex items-center rounded-md bg-white/5 hover:bg-white/10 text-slate-300 px-2.5 py-1 transition-colors">
                Versions
              </a>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>

  </div>
</div>
