<div class="animate-fade-in">

  <!-- header row -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-lg font-semibold text-slate-100 tracking-tight">Features</h2>
      <p class="text-xs text-slate-500 mt-0.5">All briefs for <%= h(project["name"]) %> &mdash; assign each to a Shape Up cycle</p>
    </div>
    <a href="/features/new?project=<%= h(project["name"]) %>"
       class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-500/20 hover:bg-indigo-500/30 border border-indigo-500/30 text-indigo-300 text-sm font-medium px-3 py-1.5 transition-all">
      + New feature
    </a>
  </div>

  <% if all_features.length() == 0 %>
    <div class="rounded-2xl glass-card border border-white/5 px-8 py-14 text-center animate-fade-in-1">
      <p class="text-slate-300 font-medium mb-1">No features yet</p>
      <p class="text-slate-500 text-sm mb-5">Write a feature brief to start shaping the work into tasks.</p>
      <a href="/features/new?project=<%= h(project["name"]) %>"
         class="inline-flex items-center gap-2 rounded-lg bg-indigo-500/80 hover:bg-indigo-400 text-white text-sm font-medium px-4 py-2 transition-colors btn-glow">
        Create first feature
      </a>
    </div>
  <% else %>
    <div class="rounded-2xl glass-card border border-white/5 overflow-hidden animate-fade-in-1">
      <div class="grid items-center bg-slate-900/80 border-b border-white/5 px-5 py-2.5 text-xs text-slate-400 uppercase tracking-wider" style="grid-template-columns: 1fr 7rem 14rem 5rem">
        <span>Feature</span>
        <span>Status</span>
        <span>Cycle</span>
        <span class="text-right">Edit</span>
      </div>
      <ul class="divide-y divide-white/[0.04]">
        <% for f in all_features %>
          <% let _fs = f.status ?? "draft" %>
          <% let _vid = f.version_id ?? "" %>
          <% let _vrow = version_lookup[_vid] %>
          <li class="grid items-center px-5 py-3 hover:bg-white/[0.02] transition-colors" style="grid-template-columns: 1fr 7rem 14rem 5rem">
            <a href="/features/<%= h(f._key) %>" class="text-sm text-slate-200 hover:text-white truncate transition-colors pr-3"><%= h(f.title) %></a>

            <span>
              <% if _fs == "done" %>
                <span class="inline-block rounded-full bg-emerald-500/15 border border-emerald-500/20 text-emerald-300 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5">done</span>
              <% elsif _fs == "in-progress" %>
                <span class="inline-block rounded-full bg-amber-500/15 border border-amber-500/20 text-amber-300 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5">active</span>
              <% elsif _fs == "ready" %>
                <span class="inline-block rounded-full bg-blue-500/15 border border-blue-500/20 text-blue-300 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5">ready</span>
              <% else %>
                <span class="inline-block rounded-full bg-slate-500/15 border border-slate-500/20 text-slate-400 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5">draft</span>
              <% end %>
            </span>

            <form method="post" action="/features/<%= h(f._key) %>/assign-cycle" class="flex items-center gap-2 pr-3">
              <select name="version_id"
                      onchange="this.form.submit()"
                      class="flex-1 min-w-0 rounded-md bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-2 py-1 text-xs text-slate-200">
                <option value="" <%= _vid == "" ? "selected" : "" %>>Unscheduled</option>
                <% for v in versions %>
                  <option value="<%= h(v._key) %>" <%= _vid == v._key ? "selected" : "" %>>
                    <%= h(v.name) %><% if (v.status ?? "") != "" %> &middot; <%= h(v.status) %><% end %>
                  </option>
                <% end %>
              </select>
              <noscript><button type="submit" class="rounded-md bg-white/5 hover:bg-white/10 text-slate-300 text-xs px-2 py-1 transition-colors">Save</button></noscript>
            </form>

            <div class="text-right">
              <a href="/features/<%= h(f._key) %>/edit" class="text-xs text-slate-400 hover:text-slate-200 transition-colors">Edit</a>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

</div>
