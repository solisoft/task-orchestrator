<div class="min-h-screen bg-slate-950 text-white">
    <div class="max-w-xl mx-auto px-6 py-10">
        <header class="mb-8">
            <a href="/" class="text-slate-500 hover:text-slate-300 text-sm">&larr; Home</a>
            <h1 class="text-3xl font-bold tracking-tight mt-1">Settings</h1>
        </header>

        <% if error != nil %>
            <div class="bg-red-500/15 border border-red-500/30 text-red-300 rounded-lg px-4 py-3 text-sm mb-6"><%= error %></div>
        <% end %>

        <form method="POST" action="/settings" class="space-y-6">
            <fieldset class="rounded-xl bg-white/5 border border-white/10 p-6 space-y-4">
                <legend class="text-sm font-medium text-slate-300 px-2">Agent</legend>

                <div>
                    <label for="agent_type" class="block text-xs text-slate-400 mb-2">Agent type</label>
                    <select name="agent_type" id="agent_type" class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-4 py-2 text-sm text-slate-100">
                        <option value="claude" <%= agent_type == "claude" ? "selected" : "" %>>claude CLI</option>
                        <option value="opencode" <%= agent_type == "opencode" ? "selected" : "" %>>opencode CLI</option>
                        <option value="opencode-sdk" <%= agent_type == "opencode-sdk" ? "selected" : "" %>>opencode SDK</option>
                    </select>
                </div>

                <div>
                    <label for="agent_path" class="block text-xs text-slate-400 mb-2">Agent binary path (optional)</label>
                    <input name="agent_path" id="agent_path" value="<%= agent_path %>" placeholder="e.g. /usr/local/bin/opencode" class="w-full rounded-lg bg-slate-900/80 border border-white/10 focus:border-indigo-400/60 outline-none px-4 py-2 text-sm text-slate-100">
                    <p class="text-xs text-slate-500 mt-1">Leave empty to use the default PATH lookup.</p>
                </div>
            </fieldset>

            <button type="submit" class="rounded-lg bg-indigo-500/90 hover:bg-indigo-400 text-white text-sm font-medium px-6 py-2 transition-colors">Save settings</button>
        </form>
    </div>
</div>