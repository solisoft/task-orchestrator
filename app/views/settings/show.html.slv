<div class="min-h-screen text-white">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <header class="mb-10 flex items-baseline justify-between animate-fade-in">
      <h1 class="text-4xl font-bold tracking-tight gradient-text">Settings</h1>
      <a href="/" class="text-sm text-slate-400 hover:text-indigo-300">← Home</a>
    </header>

    <form method="post" action="/settings" class="space-y-8">
      <fieldset class="rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-1">
        <legend class="px-2 text-sm font-semibold uppercase tracking-wider text-slate-300">Agent</legend>
        <p class="mt-2 text-sm text-slate-400">Active runner used when a task has no per-task <code>agent_type</code>.</p>
        <div class="mt-4">
          <label for="agent_type" class="block text-xs font-medium text-slate-300 mb-1">Agent type</label>
          <select id="agent_type" name="agent_type"
                  class="w-full rounded-md bg-slate-900 border border-white/10 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400/40">
            <% for a in agents %>
              <option value="<%= a %>" <%= a == agent_type ? "selected" : "" %>><%= a %></option>
            <% end %>
          </select>
        </div>
        <div class="mt-5">
          <label for="plan_model" class="block text-xs font-medium text-slate-300 mb-1">Plan model</label>
          <p class="text-xs text-slate-500 mb-2">Default model used by the feature-brief planner. Per-feature and per-run dropdowns can override this. Only models in the allowlist below show up here.</p>
          <%- partial("features/plan_model_select", {
            "name":             "plan_model",
            "current":          plan_model,
            "claude_options":   claude_options,
            "opencode_options": opencode_options,
            "include_blank":    false,
            "blank_label":      ""
          }) %>
        </div>
        <div class="mt-5">
          <label for="review_model" class="block text-xs font-medium text-slate-300 mb-1">Review model</label>
          <p class="text-xs text-slate-500 mb-2">Default model used for code reviews. Per-run dropdowns can override this. Only models in the allowlist below show up here.</p>
          <%- partial("features/plan_model_select", {
            "name":             "review_model",
            "current":          review_model,
            "claude_options":   claude_options,
            "opencode_options": opencode_options,
            "include_blank":    false,
            "blank_label":      ""
          }) %>
        </div>
      </fieldset>

      <fieldset class="rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-2">
        <legend class="px-2 text-sm font-semibold uppercase tracking-wider text-slate-300">Available models</legend>
        <p class="mt-2 text-sm text-slate-400">Tick the models you want offered everywhere a plan model can be picked (settings, per-feature, per-run). Untick all to remove the filter and surface every detected model.</p>
        <input type="hidden" name="allowed_models_present" value="1">

        <div class="mt-4">
          <h3 class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Claude SDK</h3>
          <div class="space-y-2">
            <% for id in claude_model_ids %>
              <div class="flex items-center gap-3">
                <input type="checkbox" id="allowed_<%= id %>" name="allowed_<%= id %>" value="1"
                       <%= allowed_set[id] == true ? "checked" : "" %>
                       class="h-4 w-4 rounded border-white/20 bg-slate-900 text-indigo-500 focus:ring-indigo-400/40">
                <label for="allowed_<%= id %>" class="text-sm font-mono text-slate-200"><%= claude_model_labels[id] ?? id %></label>
                <span class="text-xs text-slate-500 font-mono"><%= id %></span>
              </div>
            <% end %>
          </div>
        </div>

        <% if opencode_models != nil and opencode_models.length() > 0 %>
          <div class="mt-5">
            <h3 class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">opencode CLI</h3>
            <div class="space-y-2">
              <% for m in opencode_models %>
                <div class="flex items-center gap-3">
                  <input type="checkbox" id="allowed_<%= m %>" name="allowed_<%= m %>" value="1"
                         <%= allowed_set[m] == true ? "checked" : "" %>
                         class="h-4 w-4 rounded border-white/20 bg-slate-900 text-indigo-500 focus:ring-indigo-400/40">
                  <label for="allowed_<%= m %>" class="text-sm font-mono text-slate-200"><%= m %></label>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if allowed_orphans.length() > 0 %>
          <div class="mt-5 border-t border-white/5 pt-4">
            <h3 class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Saved but no longer detected</h3>
            <p class="text-xs text-slate-500 mb-2">These ids are in your allowlist but didn&rsquo;t appear in the current scan. Untick to drop them.</p>
            <div class="space-y-2">
              <% for id in allowed_orphans %>
                <div class="flex items-center gap-3">
                  <input type="checkbox" id="allowed_<%= id %>" name="allowed_<%= id %>" value="1" checked
                         class="h-4 w-4 rounded border-white/20 bg-slate-900 text-amber-400 focus:ring-amber-400/40">
                  <label for="allowed_<%= id %>" class="text-sm font-mono text-amber-200"><%= id %></label>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </fieldset>

      <fieldset class="rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-3">
        <legend class="px-2 text-sm font-semibold uppercase tracking-wider text-slate-300">Agent options</legend>
        <p class="mt-2 text-sm text-slate-400">Enable or disable agents available for dispatch. Changes take effect immediately.</p>
        <div class="mt-4 space-y-3">
          <% for a in agents %>
            <div class="flex items-center gap-3">
              <input type="hidden" name="enabled_<%= a %>" value="0">
              <input type="checkbox" id="enabled_<%= a %>" name="enabled_<%= a %>" value="1"
                     <%= agents_config[a] != false ? "checked" : "" %>
                     class="h-4 w-4 rounded border-white/20 bg-slate-900 text-indigo-500 focus:ring-indigo-400/40">
              <label for="enabled_<%= a %>" class="text-sm font-mono text-slate-200"><%= a %></label>
            </div>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-4">
        <legend class="px-2 text-sm font-semibold uppercase tracking-wider text-slate-300">Theme</legend>
        <p class="mt-2 text-sm text-slate-400">Pick a preset or create your own. Saved server-side so the page renders in the correct theme on first paint.</p>
        <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-4" id="preset-grid">
          <% for preset in presets %>
            <div class="preset-card rounded-xl border border-white/10 overflow-hidden cursor-pointer hover:border-indigo-400/50 transition-colors"
                 data-preset-key="<%= preset["_key"] %>"
                 data-bg="<%= preset["css_vars"]["--color-bg"] %>"
                 data-text="<%= preset["css_vars"]["--color-text"] %>"
                 data-accent="<%= preset["css_vars"]["--color-accent"] %>"
                 data-border="<%= preset["css_vars"]["--color-border"] %>"
                 data-surface="<%= preset["css_vars"]["--color-surface"] %>"
                 data-muted="<%= preset["css_vars"]["--color-muted"] %>">
              <div class="preset-preview h-20 text-sm font-mono flex items-center justify-center"
                   style="background: <%= preset["css_vars"]["--color-bg"] %>; color: <%= preset["css_vars"]["--color-text"] %>;">
                <span class="opacity-60">Aa</span>
              </div>
              <div class="p-3" style="background: <%= preset["css_vars"]["--color-surface"] %>;">
                <div class="text-sm font-medium" style="color: <%= preset["css_vars"]["--color-text"] %>;"><%= preset["name"] %></div>
                <% if preset["is_default"] == true %>
                  <div class="text-xs" style="color: <%= preset["css_vars"]["--color-muted"] %>;">built-in</div>
                <% else %>
                  <div class="text-xs" style="color: <%= preset["css_vars"]["--color-muted"] %>;">custom</div>
                <% end %>
                <% if preset["is_default"] != true %>
                  <div class="flex gap-2 mt-1">
                    <button type="button" class="preset-edit-btn text-xs text-indigo-400 hover:text-indigo-300" data-preset-key="<%= preset["_key"] %>">Edit</button>
                    <button type="button" class="preset-delete-btn text-xs text-red-400 hover:text-red-300" data-preset-key="<%= preset["_key"] %>">Delete</button>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="mt-4 flex items-center gap-4">
          <button type="button" id="new-preset-btn"
                  class="px-4 py-2 rounded-md bg-slate-700 hover:bg-slate-600 text-slate-200 text-sm transition-colors">
            + New preset
          </button>
        </div>

        <div id="new-preset-form" class="mt-4 hidden">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="preset-name" class="block text-xs font-medium text-slate-300 mb-1">Preset name</label>
              <input type="text" id="preset-name" name="preset_name"
                     class="w-full rounded-md bg-slate-900 border border-white/10 px-3 py-2 text-sm text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400/40"
                     placeholder="e.g. Solarized">
            </div>
            <div>
              <label for="preset-accent" class="block text-xs font-medium text-slate-300 mb-1">Accent color</label>
              <input type="color" id="preset-accent" name="preset_accent"
                     class="w-full h-10 rounded-md bg-slate-900 border border-white/10 px-1 py-1 text-sm cursor-pointer">
            </div>
          </div>
          <div class="mt-3 flex gap-3">
            <button type="button" id="save-preset-btn"
                    class="px-4 py-2 rounded-md bg-indigo-500 hover:bg-indigo-400 text-white text-sm font-medium transition-colors">
              Save preset
            </button>
            <button type="button" id="cancel-preset-btn"
                    class="px-4 py-2 rounded-md bg-slate-700 hover:bg-slate-600 text-slate-200 text-sm transition-colors">
              Cancel
            </button>
          </div>
        </div>

        <input type="hidden" name="theme" id="selected-theme" value="<%= theme %>">
      </fieldset>

      <fieldset class="rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-5">
        <legend class="px-2 text-sm font-semibold uppercase tracking-wider text-slate-300">Run limits</legend>
        <p class="mt-2 text-sm text-slate-400">Cap how many runs an agent may start per rolling 24h / 7d window. <code>0</code> means unlimited.</p>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-medium text-slate-400">
          <div></div>
          <div class="text-right pr-2">Daily cap</div>
          <div class="text-right pr-2">Weekly cap</div>
        </div>
        <% for a in agents %>
          <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-4 items-center">
            <div class="text-sm font-mono text-slate-200"><%= a %></div>
            <div>
              <input type="number" min="0" step="1"
                     name="limit_daily_<%= a %>"
                     value="<%= limits[a]["daily"] %>"
                     class="w-full text-right rounded-md bg-slate-900 border border-white/10 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-400/40">
            </div>
            <div>
              <input type="number" min="0" step="1"
                     name="limit_weekly_<%= a %>"
                     value="<%= limits[a]["weekly"] %>"
                     class="w-full text-right rounded-md bg-slate-900 border border-white/10 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-400/40">
            </div>
          </div>
        <% end %>
      </fieldset>

      <div class="flex items-center justify-end gap-3">
        <a href="/" class="px-4 py-2 text-sm text-slate-400 hover:text-slate-200">Cancel</a>
        <button type="submit"
                class="px-5 py-2 rounded-md bg-indigo-500 hover:bg-indigo-400 text-white text-sm font-medium transition-colors">
          Save settings
        </button>
      </div>
    </form>

    <fieldset class="mt-8 rounded-2xl glass-card p-6 animate-fade-in animate-fade-in-6">
      <legend class="px-2 text-sm font-semibold uppercase tracking-wider text-slate-300">Browser notifications</legend>
      <p class="mt-2 text-sm text-slate-400">
        Get a desktop notification when a task flips status (review / done / failed)
        even if the dashboard tab is closed. Per-browser; subscribe on every device.
      </p>
      <div class="mt-4 flex items-center gap-3">
        <button type="button" id="push-subscribe-btn"
                class="px-5 py-2 rounded-md bg-emerald-500 hover:bg-emerald-400 text-white text-sm font-medium transition-colors">
          Enable browser notifications
        </button>
        <button type="button" id="push-unsubscribe-btn"
                class="px-4 py-2 rounded-md bg-slate-700 hover:bg-slate-600 text-slate-200 text-sm transition-colors hidden">
          Disable
        </button>
        <span id="push-state" class="text-sm text-slate-400">checking…</span>
      </div>
    </fieldset>

    <script>
      (function () {
        const subscribeBtn   = document.getElementById('push-subscribe-btn');
        const unsubscribeBtn = document.getElementById('push-unsubscribe-btn');
        const stateLabel     = document.getElementById('push-state');
        if (!subscribeBtn || !stateLabel) return;
        async function refresh() {
          if (!window.taskOrchPush) {
            stateLabel.textContent = 'this browser does not support push';
            subscribeBtn.disabled = true;
            return;
          }
          const s = await window.taskOrchPush.currentState();
          if (s === 'subscribed') {
            stateLabel.textContent = 'enabled on this browser';
            subscribeBtn.classList.add('hidden');
            unsubscribeBtn.classList.remove('hidden');
          } else if (s === 'denied') {
            stateLabel.textContent = 'permission denied — re-enable in your browser settings';
            subscribeBtn.disabled = true;
          } else {
            stateLabel.textContent = 'not yet enabled';
            subscribeBtn.classList.remove('hidden');
            unsubscribeBtn.classList.add('hidden');
          }
        }
        subscribeBtn.addEventListener('click', async () => {
          stateLabel.textContent = 'subscribing…';
          try {
            await window.taskOrchPush.subscribe();
            await refresh();
          } catch (e) {
            stateLabel.textContent = 'subscribe failed: ' + e.message;
          }
        });
        unsubscribeBtn.addEventListener('click', async () => {
          stateLabel.textContent = 'unsubscribing…';
          try {
            await window.taskOrchPush.unsubscribe();
            await refresh();
          } catch (e) {
            stateLabel.textContent = 'unsubscribe failed: ' + e.message;
          }
        });
        // Wait a tick so push.js has time to define window.taskOrchPush.
        window.addEventListener('load', refresh);
      })();
    </script>

    <script>
      (function () {
        const grid          = document.getElementById('preset-grid');
        const newPresetBtn  = document.getElementById('new-preset-btn');
        const newPresetForm = document.getElementById('new-preset-form');
        const cancelBtn     = document.getElementById('cancel-preset-btn');
        const saveBtn       = document.getElementById('save-preset-btn');
        const selectedTheme = document.getElementById('selected-theme');
        const accentColor  = document.getElementById('preset-accent');

        function getCssVars(forKey) {
          var card = grid.querySelector('[data-preset-key="' + forKey + '"]');
          if (!card) return {};
          return {
            '--color-bg':      card.getAttribute('data-bg'),
            '--color-text':    card.getAttribute('data-text'),
            '--color-accent':  card.getAttribute('data-accent'),
            '--color-border':  card.getAttribute('data-border'),
            '--color-surface': card.getAttribute('data-surface'),
            '--color-muted':   card.getAttribute('data-muted')
          };
        }

        function applyCssVars(cssVars) {
          const root = document.documentElement;
          for (var k in cssVars) {
            root.style.setProperty(k, cssVars[k]);
          }
        }

        function resetCssVars() {
          const current = selectedTheme.value;
          const allCards = grid.querySelectorAll('.preset-card');
          for (var i = 0; i < allCards.length; i++) {
            if (allCards[i].getAttribute('data-preset-key') === current) {
              try {
                var cv = JSON.parse(allCards[i].getAttribute('data-css-vars') || "{}");
                applyCssVars(cv);
              } catch (e) {}
              break;
            }
          }
        }

        if (grid) {
          grid.addEventListener('click', function (e) {
            var card = e.target.closest && e.target.closest('.preset-card');
            if (!card) return;
            var key = card.getAttribute('data-preset-key');
            var cssVars = getCssVars(key);
            applyCssVars(cssVars);
            selectedTheme.value = key;
            document.querySelectorAll('.preset-card').forEach(function (c) {
              c.classList.remove('ring-2', 'ring-indigo-400');
            });
            card.classList.add('ring-2', 'ring-indigo-400');
          });
        }

        if (newPresetBtn && newPresetForm) {
          newPresetBtn.addEventListener('click', function () {
            newPresetForm.classList.remove('hidden');
            newPresetBtn.classList.add('hidden');
          });
          cancelBtn.addEventListener('click', function () {
            newPresetForm.classList.add('hidden');
            newPresetBtn.classList.remove('hidden');
            resetCssVars();
          });
          accentColor.addEventListener('input', function () {
            var preview = newPresetForm.querySelector('.preset-preview');
            if (preview) preview.style.background = accentColor.value;
          });
          saveBtn.addEventListener('click', function () {
            var name = document.getElementById('preset-name').value.trim();
            if (!name) { alert('Preset name is required'); return; }
            var accent = accentColor.value || '#6366f1';
            var cssVars = {
              '--color-bg':      '#1e293b',
              '--color-text':    '#e2e8f0',
              '--color-accent':  accent,
              '--color-border': '#334155',
              '--color-surface':'#1e293b',
              '--color-muted':  '#64748b'
            };
            fetch('/settings/presets', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name: name, css_vars: cssVars })
            }).then(function (r) {
              if (r.ok) { window.location.href = '/settings'; }
              else { alert('Failed to save preset'); }
            });
          });
        }

        document.querySelectorAll('.preset-edit-btn').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var key = btn.getAttribute('data-preset-key');
            var name = key.replace('custom:', '');
            var cssVars = getCssVars(key);
            document.getElementById('preset-name').value = name;
            if (accentColor) accentColor.value = cssVars['--color-accent'] || '#6366f1';
            newPresetForm.classList.remove('hidden');
            newPresetBtn.classList.add('hidden');
            applyCssVars(cssVars);
          });
        });

        document.querySelectorAll('.preset-delete-btn').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var key = btn.getAttribute('data-preset-key');
            var name = key.replace('custom:', '');
            if (!confirm('Delete preset "' + name + '"?')) return;
            fetch('/settings/presets/' + encodeURIComponent(name), {
              method: 'DELETE'
            }).then(function (r) {
              if (r.ok) { window.location.href = '/settings'; }
              else { alert('Failed to delete preset'); }
            });
          });
        });

        window.addEventListener('load', function () {
          var current = selectedTheme.value;
          var card = grid && grid.querySelector('[data-preset-key="' + current + '"]');
          if (card) {
            card.classList.add('ring-2', 'ring-indigo-400');
          }
        });
      })();
    </script>
  </div>
</div>
