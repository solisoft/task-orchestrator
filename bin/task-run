#!/usr/bin/env bash
#
# task-run <project> <slug>
#
# Dispatches a single agent run for a task row in the solidb `tasks`
# collection. Steps:
#
#   1. Fetch the task body from the DB (status must already be
#      `inprogress` — the dispatcher CAS-claims it before exec'ing us).
#   2. Create a fresh git worktree on a new branch off origin/main.
#   3. Write the body into the worktree's tasks/todo/<slug>.md so
#      `/do-task` finds it.
#   4. Run `claude -p "/do-task ..."` and then `/review-task` headlessly.
#   5. If review-task produced a commit: push the branch, open a PR via gh,
#      mark the row `status=done` (with `pr_url`), and tear down the
#      worktree.
#   6. Otherwise: mark `status=failed` with a reason. The log file
#      survives in either case.
#
# State files live under $TASK_ORCH_STATE (default ~/.local/state/task-orchestrator).
# The DB row is the source of truth for status / pr_url / timestamps;
# the on-disk .log / .status files are a journal for the run viewer.

set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")
project_root=$(dirname "$script_dir")

# Load .env so SOLIDB_* are available without the caller having to export.
if [[ -f "$project_root/.env" ]]; then
  set -a; source "$project_root/.env"; set +a
fi

# `--resume` skips the worktree wipe/recreate so the user's "Continue"
# button picks up from whatever uncommitted state the previous (dead)
# agent left behind. The spec md, skills, and .env.test still get
# re-seeded — they're orchestrator-owned and idempotent.
resume=0
if [[ "${1-}" == "--resume" ]]; then
  resume=1
  shift
fi

if [[ $# -ne 2 ]]; then
  echo "usage: $0 [--resume] <project> <slug>" >&2
  exit 64
fi

repo_name=$1
slug=$2
key="${repo_name}--${slug}"
md_name="${slug}.md"
branch="task/${slug}"

ROOT=${TASK_ORCH_ROOT:-$HOME/workspace/soli}
project_path="$ROOT/$repo_name"
if [[ ! -d "$project_path" ]]; then
  echo "task-run: project path not found: $project_path" >&2
  exit 65
fi

# Local-only mode: no `origin` remote means there's nowhere to push and
# no PR to open. We still run /do-task + /review-task end-to-end, but
# leave the resulting commit on the local task/<slug> branch for the
# user to merge by hand. `gh` is not required in this mode.
local_only=0
if ! git -C "$project_path" remote get-url origin >/dev/null 2>&1; then
  local_only=1
fi

# Fail fast with an actionable error rather than ENOENT mid-run.
required=(claude git jq curl)
[[ $local_only -eq 0 ]] && required+=(gh)
for cmd in "${required[@]}"; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "task-run: '$cmd' not on PATH" >&2
    echo "task-run: PATH=$PATH" >&2
    exit 127
  fi
done

# Pick a base ref. With a remote we always want origin/main so the branch
# is rebased on whatever's been merged upstream. Locally we fall back to
# `main` or `master`, whichever exists; if neither does, abort early
# rather than silently base off HEAD (we'd produce empty diffs against
# whatever the user happened to have checked out).
if [[ $local_only -eq 1 ]]; then
  if git -C "$project_path" show-ref --verify --quiet refs/heads/main; then
    base_ref="main"
  elif git -C "$project_path" show-ref --verify --quiet refs/heads/master; then
    base_ref="master"
  else
    echo "task-run: local-only mode but neither 'main' nor 'master' exists in $project_path" >&2
    exit 65
  fi
else
  base_ref="origin/main"
fi

HOST=${SOLIDB_HOST:-http://localhost:6745}
DB=${SOLIDB_DATABASE:-tasks}
USER=${SOLIDB_USERNAME:-admin}
PASS=${SOLIDB_PASSWORD:-admin}

state_root=${TASK_ORCH_STATE:-$HOME/.local/state/task-orchestrator}
state_dir="$state_root/$repo_name"
log_file="$state_dir/$slug.log"
status_file="$state_dir/$slug.status"
pid_file="$state_dir/$slug.pid"

worktree_root=${TASK_ORCH_WORKTREES:-$HOME/.cache/task-orchestrator/worktrees}
worktree_dir="$worktree_root/$repo_name/$slug"

mkdir -p "$state_dir" "$worktree_root/$repo_name"

# Single-flight guard: if a previous task-run for this slug is still
# alive, refuse rather than racing two agents in the same worktree.
# Catches a double-clicked "Continue" button and any unexpected
# dispatcher re-fire. The dispatcher's CAS already covers the normal
# launch path; this is the belt to its braces.
if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null; then
  echo "task-run: pid $(cat "$pid_file") already running for $key; aborting" >&2
  exit 75
fi

# Heartbeat for the run viewer: the .status file only flips to
# `failed:` when this script's `fail`/INT/TERM trap runs. If we get
# SIGKILLed (OOM, `pkill -9`, parent crash) the trap never fires and
# the row is stuck at "running …" forever. Drop our PID so the model
# can spot a zombie via `kill -0` and synthesize a failed indicator.
printf '%s\n' "$$" > "$pid_file"
trap 'rm -f "$pid_file"' EXIT

write_status() {
  printf '%s\t%s\n' "$(date -Is)" "$1" >> "$status_file"
}

log() {
  printf '[%s] %s\n' "$(date -Is)" "$*" | tee -a "$log_file"
}

# Update the DB row. Use AQL UPDATE so partial fields don't clobber the
# rest. Errors are logged but never abort the bash flow — the local
# .status journal is the fallback record.
db_update() {
  local patch_json="$1"
  local body
  body=$(jq -n --arg key "$key" --argjson patch "$patch_json" \
    '{
       query: "UPDATE @key WITH @patch IN tasks RETURN NEW",
       bindVars: { key: $key, patch: $patch }
     }')
  curl -s -u "$USER:$PASS" -X POST "$HOST/_api/database/$DB/cursor" \
    -H 'content-type: application/json' -d "$body" \
    >> "$log_file" 2>&1 || log "db_update failed: $patch_json"
}

# Fetch the current status from the DB; returns empty string on error.
fetch_status() {
  curl -s -u "$USER:$PASS" "$HOST/_api/database/$DB/document/tasks/$key" | jq -r '.status // empty'
}

# Single chokepoint for {status: "failed", ...} writes. The journal write
# (`write_status`) stays on the caller — it's the local record of what
# the wrapper tried to do — but the DB row is gated: a late fail path
# (trap, zombie heuristic, future writer) must NEVER flip a row the
# success path already moved to `done`.
db_update_failed() {
  local reason="$1"
  local current_status
  current_status=$(fetch_status)
  if [[ "$current_status" == "done" ]]; then
    log "not overwriting DB row: status is already 'done'"
    return 0
  fi
  db_update "$(jq -n --arg r "$reason" \
    '{status: "failed", failure_reason: $r, finished_at: now | todateiso8601}')"
}

fail() {
  log "FAIL: $*"
  write_status "failed:$*"
  db_update_failed "$*"
  exit 1
}

# SIGINT/TERM lands the row in `failed` (not `queued`) so the dispatcher
# won't auto-reclaim and wipe the worktree on its next pass. The user
# decides whether to resume via the Continue button (which already
# accepts `failed`) or unqueue and start over.
mark_interrupted() {
  log "interrupted"
  write_status "failed:interrupted"
  db_update_failed "interrupted"
  exit 130
}
trap mark_interrupted INT TERM

write_status "starting"
log "project=$project_path slug=$slug branch=$branch"

# 1. Pull the body and the user's chosen model from solidb in one round
# trip — `body_md` carries the spec; `model` decides which agent runs
# /do-task. An empty model means "use the legacy claude CLI default".
write_status "fetching task body"
body_url="$HOST/_api/database/$DB/document/tasks/$key"
row_json=$(curl -s -u "$USER:$PASS" "$body_url")
body_md=$(printf '%s' "$row_json" | jq -r '.body_md // empty')
task_model=$(printf '%s' "$row_json" | jq -r '.model // empty')
task_title=$(printf '%s' "$row_json" | jq -r '.title // empty')
if [[ -z "$body_md" ]]; then
  fail "task body empty or row not found ($key)"
fi
log "task model=${task_model:-<unset, default claude>}"

# 2. Build a fresh worktree off the chosen base ref.
write_status "preparing worktree"
if [[ $local_only -eq 1 ]]; then
  log "local-only mode (no origin remote); base=$base_ref"
else
  log "fetching $base_ref"
  git -C "$project_path" fetch --quiet origin main || fail "git fetch origin main"
fi

if [[ $resume -eq 1 ]]; then
  if [[ ! -d "$worktree_dir" ]]; then
    fail "resume requested but worktree $worktree_dir does not exist"
  fi
  log "resuming in existing worktree $worktree_dir (branch $(git -C "$worktree_dir" rev-parse --abbrev-ref HEAD))"
else
  if [[ -d "$worktree_dir" ]]; then
    log "removing stale worktree $worktree_dir"
    git -C "$project_path" worktree remove --force "$worktree_dir" 2>/dev/null || rm -rf "$worktree_dir"
  fi

  log "creating worktree at $worktree_dir on branch $branch (base $base_ref)"
  git -C "$project_path" worktree add -B "$branch" "$worktree_dir" "$base_ref" \
    >> "$log_file" 2>&1 || fail "git worktree add"
fi

# 3. Drop the body into the worktree's tasks/todo/ where /do-task looks.
# The spec is orchestrator-owned context (not project content) — but we
# can't filter it via .git/info/exclude because worktrees read excludes
# from the common git-dir, not the worktree-local one, and writing to
# the common dir would pollute the main repo. Instead, the review-task
# skill is responsible for unstaging it before commit.
mkdir -p "$worktree_dir/tasks/todo"
printf '%s' "$body_md" > "$worktree_dir/tasks/todo/$md_name"
log "seeded worktree's tasks/todo/$md_name (${#body_md} bytes)"

# 3a. Make sure the do-task / review-task skills are present. Source of
# truth is THIS project's .claude/skills/ — the orchestrator owns the
# skill definitions so they evolve with the dispatcher logic.
canonical_skills="$project_root/.claude/skills"
if [[ -d "$canonical_skills/do-task" && -d "$canonical_skills/review-task" ]]; then
  mkdir -p "$worktree_dir/.claude/skills"
  cp -r "$canonical_skills/do-task" "$worktree_dir/.claude/skills/"
  cp -r "$canonical_skills/review-task" "$worktree_dir/.claude/skills/"
  log "seeded worktree's .claude/skills/{do-task,review-task}"
else
  fail "canonical skills missing under $canonical_skills (expected do-task and review-task)"
fi

# 3b. Copy the project's `.env.test` into the worktree so `soli test`
# (which the do-task / review-task skills run for verification) can
# find it. The file is gitignored, so the worktree's checkout of
# origin/main never has it; without this, every `soli test` in the
# agent fails with "`.env.test` file not found at <worktree>/.env.test"
# and the test server's port-bind errors that follow are red
# herrings. We only copy `.env.test` (test credentials) — never the
# production `.env`, which would let the agent's tests connect to
# the orchestrator's live tasks DB.
if [[ -f "$project_path/.env.test" ]]; then
  cp "$project_path/.env.test" "$worktree_dir/.env.test"
  log "seeded worktree's .env.test"
fi

# 4. Run /do-task and /review-task headlessly.
# A `task_model` of "<provider>/<model>" routes through opencode CLI; a
# bare claude-* id pins claude --model; an empty value uses claude with
# whatever default the binary picks.
#
# An opencode model may carry a ":variant" suffix
# (e.g. "deepseek/deepseek-v4-pro:low") to pick a provider-specific
# reasoning effort — passed as `--variant` to opencode. Strip it off
# the base id here so the routing/agent_kind detection below doesn't
# get confused.
claude_jq="$script_dir/_stream-format.jq"

task_variant=""
if [[ "$task_model" == */*:* ]]; then
  task_variant="${task_model##*:}"
  task_model="${task_model%:*}"
  log "model variant=$task_variant"
fi

if [[ "$task_model" == */* ]]; then
  agent_kind="opencode"
  if ! command -v opencode >/dev/null 2>&1; then
    fail "task picked $task_model but 'opencode' is not on PATH"
  fi
else
  agent_kind="claude"
fi
log "agent_kind=$agent_kind"

run_agent() {
  local prompt="$1" phase="$2"
  write_status "$phase"
  log "running $agent_kind $prompt"
  set +e
  case "$agent_kind" in
    opencode)
      local opencode_cmd=(opencode run --format json --dangerously-skip-permissions -m "$task_model")
      if [[ -n "$task_variant" ]]; then
        opencode_cmd+=(--variant "$task_variant")
      fi
      (
        cd "$worktree_dir"
        "${opencode_cmd[@]}" < /dev/null "$prompt" 2>>"$log_file"
      ) | tee -a "$log_file.jsonl" \
        | jq -r --unbuffered -f "$claude_jq" >> "$log_file"
      ;;
    *)
      local claude_args=(--dangerously-skip-permissions -p --output-format stream-json --verbose)
      if [[ -n "$task_model" ]]; then
        claude_args+=(--model "$task_model")
      fi
      (
        cd "$worktree_dir"
        claude "${claude_args[@]}" < /dev/null "$prompt" 2>>"$log_file"
      ) | tee -a "$log_file.jsonl" \
        | jq -r --unbuffered -f "$claude_jq" >> "$log_file"
      ;;
  esac
  local rc=${PIPESTATUS[0]}
  set -e
  if [[ $rc -ne 0 ]]; then
    fail "$prompt exited non-zero (rc=$rc)"
  fi
}

# Memory rule: never run /do-task and /review-task in parallel.
run_agent "/do-task $slug" "running /do-task"
run_agent "/review-task $slug" "running /review-task"

# 5. /review-task may or may not produce a commit.
head_sha=$(git -C "$worktree_dir" rev-parse HEAD)
base_sha=$(git -C "$worktree_dir" rev-parse "$base_ref")

# Safety net: if the review-task agent missed the explicit unstage
# step and committed the orchestrator-seeded spec md, amend it out so
# the user's branch / PR doesn't carry the noise. Only acts when a
# commit was actually produced (head moved off base) and only on the
# top commit (we never rewrite history beyond the most recent commit).
if [[ "$head_sha" != "$base_sha" ]]; then
  if git -C "$worktree_dir" show --name-only --pretty=format: HEAD \
       | grep -qxF "tasks/todo/$md_name"; then
    log "safety-net: review-task committed tasks/todo/$md_name; amending it out"
    git -C "$worktree_dir" rm --cached --quiet "tasks/todo/$md_name" >> "$log_file" 2>&1 || true
    git -C "$worktree_dir" commit --amend --no-edit --quiet >> "$log_file" 2>&1 || \
      log "safety-net: amend failed; spec md may remain in HEAD commit"
    head_sha=$(git -C "$worktree_dir" rev-parse HEAD)
  fi
fi

# Copy any new tasks/todo/*.md the agent created in the worktree back to
# the source repo (those become new DB rows next ingest).
sync_new_todos() {
  [[ -d "$worktree_dir/tasks/todo" ]] || return 0
  mkdir -p "$project_path/tasks/todo"
  while IFS= read -r -d '' f; do
    local base
    base=$(basename "$f")
    [[ "$base" == "$md_name" ]] && continue
    cp "$f" "$project_path/tasks/todo/$base"
    log "propagated new todo: $base"
  done < <(find "$worktree_dir/tasks/todo" -maxdepth 1 -type f -name '*.md' -print0)
}

cleanup_worktree() {
  log "cleaning up worktree $worktree_dir"
  git -C "$project_path" worktree remove --force "$worktree_dir" >> "$log_file" 2>&1 \
    || rm -rf "$worktree_dir"
}

if [[ "$head_sha" == "$base_sha" ]]; then
  log "no commit produced — treating as no-code-change success"
  sync_new_todos
  cleanup_worktree
  iso=$(date -Iseconds)
  db_update "$(jq -n --arg iso "$iso" '{status: "done", finished_at: $iso, outcome: "no-commit"}')"
  write_status "done:no-commit"
  log "DONE — no commit (review closed without code change)"
  exit 0
fi

log "branch $branch ahead of $base_ref: $head_sha"

if [[ $local_only -eq 1 ]]; then
  # No remote, no PR. Leave the branch on disk for the user to merge.
  # The worktree is still removed (it's only ever a scratch dir); the
  # branch ref it points at survives because git worktree remove keeps
  # the underlying ref alive.
  sync_new_todos
  cleanup_worktree

  iso=$(date -Iseconds)
  db_update "$(jq -n --arg iso "$iso" --arg br "$branch" \
    '{status: "done", outcome: "local-branch", finished_at: $iso, pr_url: null}')"
  write_status "done:local-branch:$branch"
  log "DONE (local-only) — branch $branch in $project_path"
  log "  inspect:  git -C $project_path log $branch --not $base_ref"
  log "  merge:    git -C $project_path checkout $base_ref && git merge --no-ff $branch"
  exit 0
fi

write_status "pushing branch"
log "pushing $branch to origin"
git -C "$worktree_dir" push --quiet --set-upstream origin "$branch" \
  >> "$log_file" 2>&1 || fail "git push"

write_status "opening PR"
title=$(git -C "$worktree_dir" log -1 --format=%s "$base_ref..$branch" | head -1)
# Fallback chain: gh rejects --title "" with "pull request title must not
# be blank". The range can come back empty when the branch HEAD coincides
# with origin/main (e.g. after the agent reset/rebased onto a local ref
# and only the safety-net amend remains), even though head_sha != base_sha
# was true earlier. Prefer the task's stored title, then any most-recent
# commit subject, then the slug — anything beats failing the PR.
if [[ -z "$title" ]]; then
  title="$task_title"
fi
if [[ -z "$title" ]]; then
  title=$(git -C "$worktree_dir" log -1 --format=%s | head -1)
fi
if [[ -z "$title" ]]; then
  title="$slug"
fi
body="Automated by task-orchestrator. Source: tasks DB row $key."
log "opening PR: $title"
pr_url=$(
  cd "$worktree_dir"
  gh pr create --title "$title" --body "$body" --base main --head "$branch" 2>&1 | tee -a "$log_file" | tail -1
) || fail "gh pr create"
log "PR opened: $pr_url"

# 6. Mark the row done (status=review until merge; pr_url stored).
sync_new_todos
cleanup_worktree

iso=$(date -Iseconds)
db_update "$(jq -n --arg iso "$iso" --arg url "$pr_url" \
  '{status: "review", pr_url: $url, finished_at: $iso}')"
printf '%s\n' "$pr_url" > "$state_dir/$slug.pr"
write_status "done:$pr_url"
log "DONE — PR: $pr_url"
