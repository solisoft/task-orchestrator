#!/usr/bin/env bash
#
# plan-run <plan_id> <notes_path> [<model>] [<project_dir>]
#
# Background runner for the "Plan it" form button on /projects/:name/tasks/new.
# Drives the /plan-task skill through the Claude Agent SDK so canUseTool
# can intercept AskUserQuestion / ExitPlanMode and surface the question
# to the new-task form.
#
# `<model>` is forwarded to plan-run-agent.ts as --model. The form
# allowlists it server-side (see tasks_controller#_allow_plan_model)
# before this script ever sees it.
#
# `<project_dir>` is the project the plan is about — the agent reads
# *that* CLAUDE.md and globs *that* tree, not the orchestrator's. When
# omitted (interactive runs from the orchestrator dir), the runner
# falls back to its own cwd, which keeps backwards compatibility.
#
# Streams stream-json events through bin/_stream-format.jq into
# $TASK_ORCH_STATE/_plans/<plan_id>/log so the UI can tail it; captures
# the raw events to log.jsonl; on success extracts the final assistant
# text into body and writes status=done. On failure writes status=failed
# with a reason. Always cleans up the notes tmpfile on exit.
set -euo pipefail

if [[ $# -lt 2 || $# -gt 4 ]]; then
  echo "usage: $0 <plan_id> <notes_path> [<model>] [<project_dir>]" >&2
  exit 64
fi

plan_id=$1
notes_path=$2
model=${3:-}
project_dir=${4:-}

script_dir=$(dirname "$(realpath "$0")")
project_root=$(dirname "$script_dir")
if [[ -f "$project_root/.env" ]]; then
  set -a; source "$project_root/.env"; set +a
fi

state_root=${TASK_ORCH_STATE:-$HOME/.local/state/task-orchestrator}
state_dir="$state_root/_plans/$plan_id"
mkdir -p "$state_dir"

log_file="$state_dir/log"
jsonl_file="$state_dir/log.jsonl"
body_file="$state_dir/body"
status_file="$state_dir/status"
jq_file="$script_dir/_stream-format.jq"

write_status() { printf '%s\t%s\n' "$(date -Is)" "$1" >> "$status_file"; }
log()          { printf '[%s] %s\n' "$(date -Is)" "$*" >> "$log_file"; }

trap 'rm -f "$notes_path"' EXIT

write_status "starting"
log "plan-run plan_id=$plan_id notes=$notes_path model=${model:-default} project=${project_dir:-<orchestrator cwd>}"

# Validate the project_dir before either runner touches it. An empty
# value falls back to the runner's cwd (the orchestrator dir) — that's
# the legacy behavior for callers that don't know the target project.
if [[ -n "$project_dir" && ! -d "$project_dir" ]]; then
  log "project_dir not a directory: $project_dir"
  write_status "failed:bad-project-dir"
  exit 65
fi

# Model id with a "/" is provider/model — route to opencode CLI. Otherwise
# the Claude Agent SDK runner (which alone supports the AskUserQuestion
# canUseTool intercept the form's question card needs).
runner=sdk
if [[ "$model" == */* ]]; then
  runner=opencode
fi

set +e
case "$runner" in
  opencode)
    log "spawning opencode model=$model"
    # opencode picks up the /plan-task skill from cwd's .claude/skills/,
    # so we DON'T pass --dir here — that would point opencode at the
    # target project where the skill doesn't exist. The target project
    # path goes into the prompt as a second positional arg; the skill
    # uses it for Glob/Read/Grep grounding.
    prompt_args="$notes_path"
    if [[ -n "$project_dir" ]]; then
      prompt_args="$notes_path $project_dir"
    fi
    (
      opencode run --format json --dangerously-skip-permissions \
        -m "$model" \
        < /dev/null \
        "/plan-task $prompt_args" 2>>"$log_file"
    ) | tee -a "$jsonl_file" \
      | stdbuf -oL jq -r --unbuffered -f "$jq_file" >> "$log_file"
    rc=${PIPESTATUS[0]}
    ;;
  *)
    log "spawning plan-run-agent (sdk)"
    agent_args=(--plan-id "$plan_id" --state-dir "$state_dir" --notes-path "$notes_path")
    if [[ -n "$model" ]]; then
      agent_args+=(--model "$model")
    fi
    if [[ -n "$project_dir" ]]; then
      agent_args+=(--project-dir "$project_dir")
    fi
    (
      bun "$script_dir/plan-run-agent.ts" "${agent_args[@]}" 2>>"$log_file"
    ) | tee -a "$jsonl_file" \
      | stdbuf -oL jq -r --unbuffered -f "$jq_file" >> "$log_file"
    rc=${PIPESTATUS[0]}
    ;;
esac
set -e

if [[ $rc -ne 0 ]]; then
  log "agent exited rc=$rc"
  write_status "failed:rc=$rc"
  exit "$rc"
fi

# plan-run-agent.ts writes body itself when the agent exits cleanly;
# the jq fallbacks only fire if the SDK path crashed before that step,
# or if we ran via opencode (which doesn't write body itself).
if [[ ! -s "$body_file" ]]; then
  case "$runner" in
    opencode)
      # opencode emits one `text` event per chunk; group by messageID and
      # take the last message — that's the assistant's final reply.
      body=$(jq -rs '
        ([.[] | select(.type == "text") | .part.messageID] | last) as $m
        | [.[] | select(.type == "text" and .part.messageID == $m) | .part.text]
        | join("")
      ' < "$jsonl_file")
      ;;
    *)
      body=$(jq -rs '
        [.[] | select(.type == "assistant")] | last
        | (.message.content // [])
        | map(select(.type == "text") | .text)
        | add // ""
      ' < "$jsonl_file")
      ;;
  esac
else
  body=$(cat "$body_file")
fi

# Strip surrounding ``` code fences if the model wrapped the spec.
body=$(printf '%s' "$body" | awk '
  NR==1 && /^```/ { in_fence=1; next }
  in_fence && /^```$/ { in_fence=0; next }
  { print }
')

if [[ -z "$body" ]]; then
  log "agent emitted empty body"
  write_status "failed:empty-body"
  exit 1
fi

printf '%s' "$body" > "$body_file"
log "wrote body (${#body} bytes)"
write_status "done"
