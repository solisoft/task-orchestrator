#!/usr/bin/env bash
#
# plan-run <plan_id> <notes_path> [<model>] [<project_dir>]
#
# Background runner for the "Plan it" form button on /projects/:name/tasks/new.
# Drives the /plan-task skill through the Claude Agent SDK so canUseTool
# can intercept AskUserQuestion / ExitPlanMode and surface the question
# to the new-task form.
#
# `<model>` is forwarded to plan-run-agent.ts as --model. The form
# allowlists it server-side (see tasks_controller#_allow_plan_model)
# before this script ever sees it.
#
# `<project_dir>` is the project the plan is about — the agent reads
# *that* CLAUDE.md and globs *that* tree, not the orchestrator's. When
# omitted (interactive runs from the orchestrator dir), the runner
# falls back to its own cwd, which keeps backwards compatibility.
#
# All plan state (status, body, model, prompt, log) is written to the
# solidb `plans` collection via direct REST API calls (AQL UPDATE).
# The plans_controller reads back the list from Plan.all().
# On success extracts the final assistant text into body.
# Always cleans up the notes tmpfile on exit.
set -euo pipefail

if [[ $# -lt 2 || $# -gt 4 ]]; then
  echo "usage: $0 <plan_id> <notes_path> [<model>] [<project_dir>]" >&2
  exit 64
fi

plan_id=$1
notes_path=$2
model=${3:-}
project_dir=${4:-}

script_dir=$(dirname "$(realpath "$0")")
project_root=$(dirname "$script_dir")
if [[ -f "$project_root/.env" ]]; then
  set -a; source "$project_root/.env"; set +a
fi

HOST=${SOLIDB_HOST:-http://localhost:6745}
DB=${SOLIDB_DATABASE:-tasks}
USER=${SOLIDB_USERNAME:-admin}
PASS=${SOLIDB_PASSWORD:-admin}

log() { printf '[%s] %s\n' "$(date -Is)" "$*" >&2; }

db_update() {
  local patch_json="$1"
  local body
  body=$(jq -n --arg plan_id "$plan_id" --argjson patch "$patch_json" \
    '{
       query: "UPDATE @plan_id WITH @patch IN plans RETURN NEW",
       bindVars: { plan_id: $plan_id, patch: $patch }
     }')
  curl -s -u "$USER:$PASS" -X POST "$HOST/_api/database/$DB/cursor" \
    -H 'content-type: application/json' -d "$body" 2>/dev/null \
    || log "db_update failed: $patch_json"
}

# AQL UPDATE WITH merges keys, so a plain `{log: $line}` patch overwrites
# the column on every call — leaving only the most recent line visible
# in the UI. CONCAT against DOCUMENT() appends instead.
append_log() {
  local body
  body=$(jq -n --arg plan_id "$plan_id" --arg line "$1"$'\n' \
    '{
       query: "LET p = DOCUMENT(\"plans\", @plan_id) UPDATE @plan_id WITH { log: CONCAT(p.log, @line) } IN plans",
       bindVars: { plan_id: $plan_id, line: $line }
     }')
  curl -s -u "$USER:$PASS" -X POST "$HOST/_api/database/$DB/cursor" \
    -H 'content-type: application/json' -d "$body" 2>/dev/null \
    || log "append_log failed: $1"
}

write_status() { db_update "$(jq -n --arg s "$1" '{status: $s, updated_at: now | todateiso8601}')"; }
write_log()    { append_log "$1"; }
write_body()   { db_update "$(jq -n --arg b "$1" '{body: $b}')"; }
write_pq()     { db_update "$(jq -n --argjson p "$1" '{pending_question: $p}')"; }
write_pid()    { db_update "$(jq -n --argjson p "$1" '{pid: $p}')"; }

jsonl_file=$(mktemp -t plan-run.XXXXXX.jsonl)
state_dir=$(mktemp -d -t plan-run.XXXXXX)
# Heartbeat for the planner viewer: the DB row only flips to `failed:` /
# `done` when this script exits cleanly. On SIGKILL/OOM/reboot the trap
# never runs and the row sticks at "starting" forever. Drop our PID so
# the Plan model can spot a zombie via `kill -0` and synthesize a failed
# indicator. The EXIT trap nulls it back out on clean termination.
trap 'rm -f "$notes_path" "$jsonl_file"; rm -rf "$state_dir"; \
      db_update "$(jq -n "{pid: null}")" >/dev/null 2>&1 || true' EXIT

write_status "starting"
write_pid "$$"
log "plan-run plan_id=$plan_id notes=$notes_path model=${model:-default} project=${project_dir:-<orchestrator cwd>}"

if [[ -n "$project_dir" && ! -d "$project_dir" ]]; then
  log "project_dir not a directory: $project_dir"
  write_status "failed:bad-project-dir"
  exit 65
fi

runner=sdk
if [[ "$model" == */* ]]; then
  runner=opencode
fi

set +e
case "$runner" in
  opencode)
    log "spawning opencode model=$model"
    prompt_args="$notes_path"
    if [[ -n "$project_dir" ]]; then
      prompt_args="$notes_path $project_dir"
    fi
    opencode run --format json --dangerously-skip-permissions \
      -m "$model" \
      < /dev/null \
      "/plan-task $prompt_args" 2>&1 \
      | tee "$jsonl_file" \
      | stdbuf -oL jq -r --unbuffered -f "$script_dir/_stream-format.jq" 2>/dev/null \
      | stdbuf -oL tr -d '\r' \
      | while read -r line; do
          write_log "$line"
        done
    rc=${PIPESTATUS[0]}
    ;;
  *)
    log "spawning plan-run-agent (sdk)"
    agent_args=(--plan-id "$plan_id" --state-dir "$state_dir" --notes-path "$notes_path")
    if [[ -n "$model" ]]; then
      agent_args+=(--model "$model")
    fi
    if [[ -n "$project_dir" ]]; then
      agent_args+=(--project-dir "$project_dir")
    fi
    bun "$script_dir/plan-run-agent.ts" "${agent_args[@]}" 2>&1 \
      | tee "$jsonl_file" \
      | stdbuf -oL jq -r --unbuffered -f "$script_dir/_stream-format.jq" 2>/dev/null \
      | stdbuf -oL tr -d '\r' \
      | while read -r line; do
          write_log "$line"
        done
    rc=${PIPESTATUS[0]}
    ;;
esac
set -e

if [[ $rc -ne 0 ]]; then
  log "agent exited rc=$rc"
  write_status "failed:rc=$rc"
  exit "$rc"
fi

# Extract body from the captured stream. The jsonl tee mixes stderr in,
# so first parse each line as JSON (skipping non-JSON noise) and slurp
# the resulting values for the format-specific extractor.
case "$runner" in
  opencode)
    # opencode emits one `text` event per chunk; group by messageID and
    # take the last message — that's the assistant's final reply.
    body=$(jq -R 'fromjson? // empty' "$jsonl_file" | jq -rs '
      ([.[] | select(.type == "text") | .part.messageID] | last) as $m
      | [.[] | select(.type == "text" and .part.messageID == $m) | .part.text]
      | join("")
    ')
    ;;
  *)
    # SDK emits nested content blocks; take the last assistant message
    # and join its text parts.
    body=$(jq -R 'fromjson? // empty' "$jsonl_file" | jq -rs '
      [.[] | select(.type == "assistant")] | last
      | (.message.content // [])
      | map(select(.type == "text") | .text)
      | add // ""
    ')
    ;;
esac

# Strip surrounding ``` code fences if the model wrapped the spec.
body=$(printf '%s' "$body" | awk '
  NR==1 && /^```/ { in_fence=1; next }
  in_fence && /^```$/ { in_fence=0; next }
  { print }
')

if [[ -z "$body" ]]; then
  log "agent emitted empty body"
  write_status "failed:empty-body"
  exit 1
fi

write_body "$body"
log "wrote body (${#body} bytes)"
write_status "done"