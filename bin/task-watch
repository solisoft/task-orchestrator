#!/usr/bin/env bash
#
# task-watch <project_path>
#
# Watches the project's tasks/queued/ directory for new .md files and fires
# bin/task-run for each one. Multiple drops fire in parallel — each task-run
# creates its own worktree and branch, so they don't step on each other
# unless they touch the same source file.
#
# Designed to run under systemd-user (see systemd/user/task-watch@.service)
# or interactively (`./bin/task-watch /path/to/repo`).

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <project_path>" >&2
  exit 64
fi

project_path=$(realpath "$1")
queued_dir="$project_path/tasks/queued"
script_dir=$(dirname "$(realpath "$0")")
runner="$script_dir/task-run"

if ! command -v inotifywait >/dev/null 2>&1; then
  echo "task-watch: inotifywait not found — install \`inotify-tools\`" >&2
  exit 127
fi

if [[ ! -x "$runner" ]]; then
  echo "task-watch: $runner is not executable" >&2
  exit 127
fi

mkdir -p "$queued_dir"
echo "[task-watch] watching $queued_dir"

# Also process anything already in queued/ at startup (in case a drop landed
# while the watcher was down).
shopt -s nullglob
for f in "$queued_dir"/*.md; do
  echo "[task-watch] catch-up dispatch: $f"
  "$runner" "$project_path" "$f" &
done
shopt -u nullglob

# `close_write` fires when an editor finishes writing the file in place;
# `moved_to` fires when `mv tasks/todo/X.md tasks/queued/` is used (the
# expected workflow from the web UI). Either way, we re-check that the
# file exists and is a `.md`.
inotifywait -m -e close_write,moved_to --format '%f' --quiet "$queued_dir" |
  while read -r filename; do
    case "$filename" in
      *.md)
        full="$queued_dir/$filename"
        if [[ -f "$full" ]]; then
          echo "[task-watch] dispatching $filename"
          "$runner" "$project_path" "$full" &
        fi
        ;;
    esac
  done
